var ryis_is_hammering = false;
var ryis_is_sawing = false;
var landen_is_hammering = false;
var henrietta_is_hammering = false;

fun ryis_hammer_sound() {
	if ryis_is_hammering == false {
		wait(0.7);
		return;
	}
	play_sound("SoundEffects/Tools/RyisHammerSwingAndHitWood2D");
	wait(0.7);
}

fun ryis_saw_sound() {
	if ryis_is_sawing == false {
		wait(0.45);
		return;
	}
	play_sound("SoundEffects/Tools/SawBackAndForth2D");
	wait(0.45);
}

fun landen_hammer_sound() {
	if landen_is_hammering == false {
		wait(0.7);
		return;
	}
	play_sound("SoundEffects/Tools/RyisHammerSwingAndHitWood2D");
	wait(0.7);
}

fun henrietta_hammer_sound() {
	if henrietta_is_hammering == false {
		wait(0.7);
		return;
	}
	play_sound("SoundEffects/Tools/RyisHammerSwingAndHitWood2D");
	wait(0.7);
}

fun ari_hammer() {
	animate(ari, axe);
	ari_set_attachment(craftinghammer);
}

fun ari_saw() {
	animate(ari, axe);
	ari_set_attachment(craftingsaw);
}

fun ari_dig() {
	animate(ari, shovel);
	ari_set_attachment(shovel_worn);
}
fun ari_swing() {
	play_sound("SoundEffects/Tools/AxeAndPickSwing");
	animate(ari, axe);
	free {
		wait(0.2);
		__chop_node(axe_worn, 146, 24);
	}
	ari_set_attachment(axe_worn);
	await_ari_animation();
	animate(ari, idle);
}


