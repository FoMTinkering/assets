fun ari_dig() {
	animate(ari, shovel);
	ari_set_attachment(shovel_worn);
}

fun ari_hammer() {
	animate(ari, axe);
	ari_set_attachment(craftinghammer);
}

fun ari_saw() {
	animate(ari, axe);
	ari_set_attachment(craftingsaw);
}

scene(town);
place_actor(nora, west, rtgs2_nora_entrance);
