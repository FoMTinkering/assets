scene(general_store_store);
place_actor(adeline, east, utsm_adeline_entrance);
place_actor(ari, north, utsm_ari_entrance);
place_actor(nora, north, utsm_nora_register);
camera_position(utsm_camera_2);
request_music_play("Music/Events/Cutscene");

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		pan_camera(2, utsm_camera_1);
	}
	{
		walk_slow(nora, utsm_nora_entrance);
		face(nora, west);
		walk_slow(nora, utsm_nora_start);
		face(nora, west);
	}
	{
		wait(1.25);
		next_line(); //
		next_line(); //
		next_line(); //
	}
	{
		face(ari, east);
		wait(1);
		face(ari, north);
	}
}
close_textbox();
wait(0.5);
free bark_speech(ari, question_mark);
wait(0.5);
face(nora, south);
wait(0.5);
sim {
	{
		wait(0.25);
		face(adeline, south);
		wait(1);
		face(adeline, east);
	}
	{
		next_line(); //
		next_line(); //
	}
}
sim {
	{
		wait(0.5);
		face(nora, west);
	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(nora, exclamation_mark);
free bark_speech(ari, exclamation_mark);
wait(1);
face(adeline, south);
wait(0.25);
free bark_speech(adeline, cute_face);
wait(0.5);
face(adeline, east);
wait(0.5);
next_line(); //
next_line(); //
close_textbox();
wait(0.5);
face(adeline, south);
animate(adeline, write);
wait(1);
sim {
	{
		pan_camera(2, utsm_camera_3);
	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
free pan_camera(1, utsm_camera_1);
wait(0.5);
free bark_speech(nora, sweat_drop);
wait(1);
animate(adeline, idle);
face(adeline, east);
wait(0.5);
next_line(); //
next_line(); //
next_line(); //

sim {
	{
		wait(0.5);
		face(adeline, south);
		animate(adeline, write);
	}
	{
		next_line(); //
	}
}

sim {
	{
		wait(1.25);
		animate(adeline, idle);
		face(adeline, east);
	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(0.5);
walk_slow(adeline, utsm_adeline_start);
face(adeline, east);
animate(adeline, action);
wait(0.1);
animate(nora, action);
wait(0.5);
animate(adeline, idle);
wait(0.1);
animate(nora, idle);
sim {
	{
		walk_slow(adeline, utsm_adeline_entrance);
		face(adeline, east);
	}
	{
		wait(0.5);
		face(nora, south);
		animate(nora, tap);
	}
	{
		wait(1);
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(nora, ellipses);
wait(2);
free bark_speech(nora, exclamation_mark);
wait(0.5);
animate(nora, idle);
face(nora, west);
next_line(); //
close_textbox();
wait(0.5);
free bark_speech(adeline, sweat_drop);
wait(2);
next_line(); //
close_textbox();
wait(0.5);
free bark_speech(nora, sweat_drop);
wait(0.5);
sim {
	{
		animate(nora, tap);
		wait(2);
		free bark_speech(nora, ellipses);
		wait(1);
	}
	{
		wait(2.5);
		next_line(); //
	}
}

close_textbox();
wait(0.5);
animate(nora, idle);
face(nora, west);
wait(0.5);
free bark_speech(adeline, ellipses);
free bark_speech(nora, ellipses);
wait(1.6);
sim {
	{
		wait(3);
		pan_camera(2, utsm_camera_2);
	}
	{
		next_line(); //
	}
}

//
close_textbox();
wait(0.25);
sim {
	{
		pan_camera(0.75, utsm_camera_1);
	}
	{
		free bark_speech(adeline, exclamation_mark);
		free bark_speech(nora, exclamation_mark);
		wait(0.5);
		face(adeline, south);
		face(nora, south);
	}
	{
		wait(1);
		next_line(); //
	}
}
sim {
	{
		wait(0.75);
		animate(adeline, write);
	}
	{
		wait(1.25);
		face(nora, west);
		wait(0.5);
		animate(nora, tap);
	}
	{
		next_line(); //
	}
}

sim {
	{
		wait(1);
		animate(adeline, idle);
		face(adeline, east);
	}
	{
		wait(0.5);
		animate(nora, idle);
		face(nora, south);
	}
	{
		next_line(); //
	}
}

sim {
	{
		wait(0.5);
		face(adeline, south);
	}
	{
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(ari, cute_face);
wait(1);
free bark_speech(adeline, cute_face);
free bark_speech(nora, cute_face);
wait(0.5);
fade_out(2);
