scene(landens_house_f1);
camera_position(utcs1_camera_1);
place_actor(ari, east, utcs1_ari_entrance);
place_actor(adeline, south, utcs1_adeline_entrance);
animate(adeline, write);
place_actor(landen, west, utcs1_landen_entrance);
place_actor(ryis, east, utcs1_ryis_entrance);
request_music_play("Music/Events/Cutscene");

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		pan_camera(4, utcs1_camera_2);
	}
	{
		walk_slow(ari, utcs1_ari_start);
		face(ari, north);
	}
	{
		free bark_speech(adeline, woodcrafting);
		wait(1);
		free bark_speech(ryis, five);
		wait(1);
		free bark_speech(landen, four);
		wait(1);
		free bark_speech(ryis, exclamation_mark);
	}
	{
		wait(3.5);
		face(ryis, south);
	}
	{
		wait(4);
		face(landen, south);
	}
	{
		wait(4.5);
		animate(adeline, idle);
	}
	{
		wait(4);
		next_line(); //
	}
}
close_textbox();

