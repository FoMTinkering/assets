		create_animation(spr_fx_twinkle_1, rtss_dust_stairs_5, 0, 0, 0, -5000);
		wait(0.25);
		create_animation(spr_fx_twinkle_1, rtss_dust_stairs_6, 0, 0, 0, -5000);
		wait(0.1);
	}
	{
		wait(4);
		override_requirement("unlocked_summit");
		update_narrows_control();
		refresh_room_layers();
		play_sound("SoundEffects/SpecialEvents/RevealTransition");
	}
	free {
		wait(4.5);
		create_animation(spr_fx_twinkle_1, rtss_dust_stairs_1, 0, 0, 0, -5000);
		wait(0.25);
		create_animation(spr_fx_twinkle_1, rtss_dust_stairs_2, 0, 0, 0, -5000);
