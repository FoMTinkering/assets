var keep_swinging_ari = true;

fun ari_swing() {
  if keep_swinging_ari == false {
    return;
  }
	play_sound("SoundEffects/Tools/AxeAndPickSwing");
	free {
		wait(0.25);
		play_sound("SoundEffects/Tools/PickDamageRock");
	}
	animate(ari, axe);
	ari_set_attachment(pick_axe_worn);
	await_ari_animation();
	animate(ari, idle);
	wait(0.5);
}

var ryis_is_hammering = true;
var eiland_is_picking = false;

fun ryis_hammer_sound() {
	if ryis_is_hammering == false {
		wait(0.5);
		return;
	}
	play_sound("SoundEffects/Tools/RyisHammerSwingAndHitWood2D");
	wait(0.7);
}

