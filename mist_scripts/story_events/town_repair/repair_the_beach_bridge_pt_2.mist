var ari_is_hammering = false;
var ari_is_sawing = false;

fun ari_saw_sound() {
	if ari_is_sawing == false {
		return;
	}
	play_sound("SoundEffects/Tools/SawBackAndForth2D");
	wait(0.9);
	if ari_is_sawing == false {
		return;
	}
	ari_saw_sound();
}

fun ari_saw() {
	sim {
		animate(ari, saw);
		ari_set_attachment(craftingsaw);
		face(ari, east);
	}
	{
		ari_saw_sound();
	}
}
fun ari_hammer_sound() {
	if ari_is_hammering == false {
		return;
	}
	wait(0.1);
	play_sound("SoundEffects/Tools/BlacksmithingHammerSwingAndHit2D");
	wait(0.35);
	if ari_is_hammering == false {
		return;
	}
	ari_hammer_sound();
}

fun ari_hammer() {
	sim {
		{
			animate(ari, axe);
			ari_set_attachment(craftinghammer);
			face(ari, east);
		}
		{
			free ari_hammer_sound();
		}
	}

}

fun ari_dig() {
	animate(ari, shovel);
	ari_set_attachment(shovel_worn);
}

