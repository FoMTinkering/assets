    {
        wait(2);
        face(zorel, north);
    }
    {
        wait(0.5);
        face(adeline, east);
    }
    {
        wait(1);
        face(landen, east);
    }
    {
        pan_camera(4, rtbt1_camera_3);
    }
    {
        next_line(); //
        next_line(); //
