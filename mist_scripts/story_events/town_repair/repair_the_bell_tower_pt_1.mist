//
sim {
    {
        pan_camera(1, rtbt1_camera_6);
    }
    {
		create_animation(spr_fx_poof1_dirt_once, rtbt1_dust_1, 0, 0, 0, -5000);
		wait(0.1);
		create_animation(spr_fx_poof1_dirt_once, rtbt1_dust_2, 0, 0, 0, -5000);
