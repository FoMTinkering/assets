scene(town);
place_actor(adeline, south, rtbt1_adeline_entrance);
animate(adeline, write);
place_actor(landen, east, rtbt1_landen_entrance);
place_actor(zorel, west, rtbt1_zorel_entrance);

request_music_play("Music/Events/Cutscene");

var ari_position_x = get_position_x(ari);
var ari_position_y = get_position_y(ari);
if ari_position_x <= 460 {
    //
    place_actor(ari, east, rtbt1_ari_west_entrance);
    sim {
        {
            wait(0.5);
            fade_in(2);
        }
        {
            camera_position(rtbt1_camera_1_west);
            pan_camera(3, rtbt1_camera_2);
        }
        {
            walk_slow(ari, rtbt1_ari_start);
            face(ari, north);
        }
        {
            wait(0.5);
            free bark_speech(landen, woodcrafting);
            wait(1);
            free bark_speech(zorel, exclamation_mark);
        }
        {
            wait(2);
            face(landen, west);
            wait(0.5);
            face(landen, south);
        }
        {
            wait(3);
            face(zorel, south);
        }
        {
            wait(2.5);
            animate(adeline, idle);
        }
    }

} else if ari_position_y >= 1390 {
    //
    place_actor(ari, north, rtbt1_ari_south_entrance);
    sim {
        {
            wait(0.5);
            fade_in(2);
        }
        {
            camera_position(rtbt1_camera_1_south);
            pan_camera(3, rtbt1_camera_2);
        }
        {
            walk_slow(ari, rtbt1_ari_start);
            face(ari, north);
        }
        {
            wait(0.5);
            free bark_speech(landen, woodcrafting);
            wait(1);
            free bark_speech(zorel, exclamation_mark);
        }
        {
            wait(2);
            face(landen, south);
        }
        {
            wait(2.5);
            face(zorel, south);
        }
        {
            wait(3);
            animate(adeline, idle);
        }
    }

} else {
    //
    place_actor(ari, west, rtbt1_ari_east_entrance);
    sim {
        {
            wait(0.5);
            fade_in(2);
        }
        {
            camera_position(rtbt1_camera_1_east);
            pan_camera(3, rtbt1_camera_2);
        }
        {
            walk_slow(ari, rtbt1_ari_start);
            face(ari, north);
        }
        {
            wait(0.5);
            free bark_speech(zorel, woodcrafting);
            wait(1);
            free bark_speech(landen, exclamation_mark);
        }
        {
            wait(3);
            face(landen, south);
        }
        {
            wait(2);
            face(zorel, east);
            wait(0.5);
            face(zorel, south);
        }
        {
            wait(2.5);
            animate(adeline, idle);
        }
    }
}

//
free bark_speech(zorel, cute_face);
wait(1.5);
next_line(); //
