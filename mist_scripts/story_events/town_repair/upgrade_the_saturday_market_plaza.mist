scene(manor_house_entry);
place_actor(nora, west, utsmp_nora_entrance);
place_actor(adeline, east, utsmp_adeline_entrance);
place_actor(ari, north, utsmp_ari_entrance);
camera_position(utsmp_camera_1);
request_music_play("Music/Events/Cutscene");

sim {
    {
        wait(0.5);
        fade_in(2);
    }
    {
        pan_camera(3, utsmp_camera_2);
    }
    {
        sim {
            walk(ari, utsmp_ari_start);
            set_move_speed(ari, 0.6);
        }
        face(ari, north);
    }
    {
        free bark_speech(adeline, question_mark);
        wait(1);
        free bark_speech(nora, crafting);
        wait(1);
        free bark_speech(adeline, sweat_drop);
        wait(1);
        free bark_speech(nora, exclamation_mark);
    }
    {
        wait(3.25);
        face(nora, south);
    }
    {
        wait(3.75);
        face(adeline, south);
    }
}
next_line(); //
sim {
    {
        wait(0.5);
        face(nora, west);
    }
    {
        next_line(); //
    }
}
sim {
    {
        wait(1);
        face(adeline, east);
    }
    {
        next_line(); //
    }
}
