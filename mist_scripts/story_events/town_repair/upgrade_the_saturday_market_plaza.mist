        face(nora, north);
    }
    {
        walk(ari, utsmp_ari_entrance);
        face(ari, south);
    }
    {
        wait(1);
        walk(adeline, utsmp_ari_entrance);
        face(adeline, south);
    }
    {
        fade_out(2);
    }
}

