    wait(0.25);
    try_create_animation(animation, rti2_dust_east_6, kill);
    wait(0.1);
    try_create_animation(animation, rti2_dust_east_7, kill);
	if east_construction_poof == false {
        return;
    }
    if east_construction_plus == true {
        wait(0.1);
        try_create_animation(animation, rti2_dust_east_8, kill);
        wait(0.25);
        try_create_animation(animation, rti2_dust_east_9, kill);
        wait(0.1);
        try_create_animation(animation, rti2_dust_east_10, kill);
        wait(0.1);
    }
    wait(0.1);
    east_construction(animation);
}

