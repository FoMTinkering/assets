var ari_is_sawing = false;
var landen_is_hammering = false;
var construction_in_progress = false;
var ryis_is_sawing = false;
var west_construction_poof = false;
var east_construction_poof = false;
var west_construction_plus = false;
var east_construction_plus = false;
var east_bed_poof = false;
var east_bed_plus = false;
var west_bed_poof = false;
var west_bed_plus = false;
var kill = false;

fun ari_saw_sound() {
	if ari_is_sawing == false {
		return;
	}
	play_sound("SoundEffects/Tools/SawBackAndForth2D");
	wait(0.9);
	if ari_is_sawing == false {
		return;
	}
	ari_saw_sound();
}

fun ari_saw() {
	sim {
		animate(ari, saw);
		ari_set_attachment(craftingsaw);
		face(ari, east);
	}
	{
		ari_saw_sound();
	}
}

fun landen_hammer_sound() {
	if landen_is_hammering == false {
		return;
	}
	play_sound("SoundEffects/Tools/RyisHammerSwingAndHitWood2D");
	wait(0.7);
	if landen_is_hammering == false {
		return;
	}
	landen_hammer_sound();
}

fun construction_sounds() {
	if construction_in_progress == false {
		return;
	}
	play_sound("SoundEffects/SpecialEvents/Construction");
	wait(2);
	if construction_in_progress == false {
		return;
	}
	construction_sounds();
}

fun ryis_saw_sound() {
	if ryis_is_sawing == false {
		return;
	}
	play_sound("SoundEffects/Tools/SawBackAndForth2D");
	wait(0.45);
	if ryis_is_sawing == false {
		return;
	}
	ryis_saw_sound();
}

fun try_create_animation(animation, trellis_point, killed) {
    if killed == true {
        return;
    }
    create_animation(animation, trellis_point, 0, 0, 0, -5000);
}

fun west_construction(animation) {
    if west_construction_poof == false {
        return;
    }
    wait(0.25);
    try_create_animation(animation, rti2_dust_west_1, kill);
    wait(0.25);
    try_create_animation(animation, rti2_dust_west_2, kill);
    wait(0.1);
    try_create_animation(animation, rti2_dust_west_3, kill);
	if west_construction_poof == false {
        return;
    }
    wait(0.25);
    try_create_animation(animation, rti2_dust_west_4, kill);
    wait(0.1);
    try_create_animation(animation, rti2_dust_west_5, kill);
    wait(0.25);
    try_create_animation(animation, rti2_dust_west_6, kill);
    wait(0.1);
    try_create_animation(animation, rti2_dust_west_7, kill);
	if west_construction_poof == false {
        return;
    }
    if west_construction_plus == true {
        wait(0.1);
        try_create_animation(animation, rti2_dust_west_8, kill);
        wait(0.25);
        try_create_animation(animation, rti2_dust_west_9, kill);
        wait(0.1);
        try_create_animation(animation, rti2_dust_west_10, kill);
        wait(0.1);
    }
    wait(0.1);
    west_construction(animation);
}

fun east_construction(animation) {
    if east_construction_poof == false {
        return;
    }
    wait(0.5);
    try_create_animation(animation, rti2_dust_east_1, kill);
    wait(0.25);
    try_create_animation(animation, rti2_dust_east_2, kill);
    wait(0.1);
