scene(eastern_road);
place_actor(adeline, east, rtb2_adeline_entrance);
place_actor(ryis, west, rtb2_ryis_entrance);
place_actor(balor, north, rtb2_balor_entrance);
place_actor(nora, south, rtb2_nora_entrance);
animate(nora, tap);
place_actor(ari, east, rtb2_ari_entrance);
camera_position(rtb2_camera_1);
request_music_play("Music/Events/Cutscene");

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		walk_slow(ari, rtb2_ari_start);
		face(ari, east);
	}
	{
		walk_slow(adeline, rtb2_adeline_start);
		face(adeline, east);
	}
	{
		free bark_speech(nora, adeline);
		wait(0.75);
		free bark_speech(balor, coin);
		wait(0.75);
		free bark_speech(ryis, mining);
		wait(1);
		free bark_speech(ryis, exclamation_mark);
		wait(0.5);
		free bark_speech(nora, exclamation_mark);
	}
	{
		wait(3);
		animate(nora, idle);
		face(nora, west);
		wait(0.25);
		face(balor, west);
	}
	{
		wait(3.5);
		next_line(); //
		next_line(); //
	}
	pan_camera(3, rtb2_camera_2);
}
sim {
	{
		wait(0.5);
		face(balor, east);
	}
	{
		next_line(); //
	}
}
close_textbox();
bark_speech(ryis, cute_face);
sim {
	{
		wait(0.25);
		face(ryis, east);
		wait(0.75);
		face(nora, east);
	}
	fade_out(2);
	free pan_camera(6, rtb2_camera_3);
}
//
play_sound("SoundEffects/SpecialEvents/Construction");
wait(4);
override_requirement("repaired_eastern_road_bridge");
refresh_room_layers();
camera_position(rtb2_camera_3);
place_actor(adeline, south, rtb2_adeline_group);
animate(adeline, write);
place_actor(ryis, east, rtb2_ryis_fix);
animate(ryis, hammer);
place_actor(balor, east, rtb2_balor_group);
place_actor(nora, east, rtb2_nora_group);
place_actor(ari, east, rtb2_ari_group);

sim {
	fade_in(2);
	{
		wait(0.75);
		animate(ryis, idle);
		face(ryis, south);
		wait(0.5);
		animate(ryis, wipebrow);
		wait(0.5);
		animate(ryis, idle);
		face(ryis, west);
	}
	{
		wait(2);
		face(balor, north);
		wait(1.5);
		face(balor, south);
		wait(1.5);
		face(balor, east);
	}
	{
		wait(2.5);
		next_line(); //
		next_line(); //
	}
	{
		wait(1.75);
		pan_camera(3, rtb2_camera_4);
	}
}
sim {
	{
		wait(1);
		animate(adeline, idle);
		face(adeline, south);
		wait(2);
		face(adeline, east);
	}
	{
		wait(0.5);
		walk_slow(ryis, rtb2_ryis_group);
		face(ryis, north);
	}
	free {
		wait(1.5);
		face(nora, north);
		wait(0.5);
		face(balor, west);
	}
	{
		next_line(); //
		next_line(); //
	}
}
sim {
	{
		wait(1);
		face(adeline, south);
	}
	{
		next_line(); //
	}
}
sim {
	{
		wait(1);
		face(adeline, east);
	}
	{
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(adeline, cute_face);
free bark_speech(balor, cute_face);
free bark_speech(nora, cute_face);
free bark_speech(ryis, cute_face);
free bark_speech(ari, cute_face);
wait(1);
//
//
//
//
fade_out(2);
