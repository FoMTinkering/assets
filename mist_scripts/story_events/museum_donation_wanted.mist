scene(museum_entry);
camera_position(mdw_camera_1);
place_actor(errol, south, mdw_errol_entrance);
animate(errol, magnify);
place_actor(ari, north, mdw_ari_entrance);
request_music_play("Music/Events/Cutscene");

//
