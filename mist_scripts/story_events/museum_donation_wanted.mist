	{
		wait(0.25);
		fade_in(2);
	}
	{
		wait(0.5);
		walk_slow(ari, mdw_ari_start);
		face(ari, north);
		wait(0.75);
		face(ari, west);
	}
	{
		wait(1.25);
		free bark_speech(errol, exclamation_mark);
		wait(0.5);
		animate(errol, idle);
		wait(0.5);
		walk(errol, mdw_errol_start);
	}
	{
		wait(2.25);
		next_line(); //
	}
	pan_camera(4, mdw_camera_2);
}
next_line(); //
close_textbox();
wait(0.5);
free bark_speech(ari, cute_face);
wait(0.5);
next_line(); //
