scene(farm);
request_music_play("Music/Events/Cutscene");
camera_position(ssf_camera_1);
place_actor(ari, south, ssf_ari_door);
place_actor(elsie, west, ssf_elsie_entrance);

sim {
	fade_in(2);
	{
		walk_slow(elsie, ssf_elsie_start);
		face(elsie, west);
	}
	{
		wait(0.5);
		free bark_speech(elsie, exclamation_mark);
		wait(0.5);
		free bark_speech(ari, exclamation_mark);
		wait(0.5);
		face(ari, east);
	}
	{
		walk(ari, ssf_ari_entrance);
		face(ari, south);
	}
	{
		wait(2);
		next_line(); //
	}
	pan_camera(1.5, ssf_camera_2);
}
close_textbox();
free bark_speech(elsie, cute_face);
wait(1);
next_line(); //
next_line(); //
free close_textbox();
free bark_speech(elsie, cute_face);
wait(1);
free bark(ari, blush);
wait(1.5);
next_line(); //
next_line(); //
next_line(); //
next_line(); //
next_line(); //
next_line(); //
next_line(); //
next_line(); //
next_line(); //
free close_textbox();
wait(0.5);
sim {
	bark_speech(ari, cute_face);
	bark_speech(elsie, cute_face);
}

next_line(); //
next_line(); //
next_line(); //
sim {
	{
		next_line(); //
		close_textbox();
	}
	{
		wait(0.5);
		animate(elsie, action);
		wait(0.5);
		animate(elsie, idle);
		ari_hold_item(inn_menu);
		if read_world_fact("caldarus_home") == true {
			animate(elsie, action);
			wait(0.5);
			animate(elsie, idle);
			ari_hold_item(picnic_set);
		}
	}
}
next_line(); //
next_line(); //
next_line(); //
next_line(); //
close_textbox();
wait(0.5);
free bark_speech(elsie, cute_face);
wait(1);
free bark_speech(ari, cute_face);
wait(1);
sim {
	fade_out(2);
	{
		wait(0.5);
		walk_slow(elsie, ssf_elsie_exit);
		face(elsie, east);
	}
}
__raise_textbox();
next_line(); //
close_textbox();
if get_response() == 0 {
	wait(0.25);
	run_tutorial(dates);
}
