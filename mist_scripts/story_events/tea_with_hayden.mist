//
//
//
//
//
//
//
//
//
//
//
//

sim {
	{
		wait(0.5);
		animate(hayden, idle);
		walk_slow(hayden, twh_hayden_end);
		face(hayden, west);
		item_give_sequence(hayden, twh_hayden_end);
	}
	{
		wait(1.5);
		face(henrietta, south);
	}
	{
		wait(2);
		sim {
			walk_slow(ari, twh_ari_stand);
			animate(ari, idle);
		}
		face(ari, east);
	}
	{
		wait(0.5);
		pan_camera(2, twh_camera_4);
	}
	{
		next_line(); //
		close_textbox();
	}
}

next_line(); //
if get_response() == 0 {
	close_textbox();
	wait(0.25);
	run_tutorial("ranching");
}
wait(0.25);
next_line(); //
next_line(); //
close_textbox();
wait(0.5);
free bark_speech(hayden, cute_face);
wait(1);
free bark_speech(ari, cute_face);
wait(1);

//
fade_out(2);
