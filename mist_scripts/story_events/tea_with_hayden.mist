fun item_give_sequence(actor, start_location) {
	walk_slow(actor, twh_hayden_give);
	face(actor, west);
	animate(actor, action);
	wait(0.5);
	animate(actor, idle);
	wait(0.5);
	walk_slow(actor, start_location);
	face(actor, west);
}

scene(haydens_house);
place_actor(hayden, south, "Hayden Counter");
place_actor(henrietta, east, twh_henrietta_entrance);
animate(henrietta, sleep);
place_actor(ari, north, twh_ari_start);
camera_position(twh_camera_1);
request_music_play("Music/Events/Cutscene");

//

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	pan_camera(5, twh_camera_2);
	{
		wait(1.5);
		walk_slow(ari, twh_ari);
		face(ari, north);
	}
	{
		wait(2.5);
		free bark_speech(hayden, exclamation_mark);
	}
	{
		wait(3.5);
		free bark(henrietta, exclamation_mark);
		wait(0.25);
		animate(henrietta, idle);
		wait(0.25);
		face(henrietta, south);
	}
	{
		wait(3.5);
		next_line(); //
	}
}
close_textbox();
sim {
	{
		walk(hayden, "Table Seat 1");
		face(hayden, south);
		animate(hayden, sit);
	}
	{
		wait(0.5);
		walk_slow(ari, "Table Seat 3");
		face(ari, north);
		animate(ari, sit);
	}
	free {
		wait(1.25);
		walk(henrietta, twh_henrietta_hop);
		face(henrietta, south);
		animate(henrietta, jump);
		await_npc_animation(henrietta);
		place_actor(henrietta, south, twh_henrietta_seat);
		animate(henrietta, idle);
		wait(0.5);
		face(henrietta, west);
	}
	{
		wait(0.5);
		pan_camera(3, twh_camera_3);
	}
	{
		wait(2.5);
		next_line(); //
	}
}
next_line(); //
next_line(); //
next_line(); //
next_line(); //
next_line(); //
close_textbox();
wait(0.25);
animate(henrietta, flap);
free bark(henrietta, music);
play_sound("SoundEffects/Animals/ChickenHenriettaCutscene");
wait(0.5);
animate(henrietta, idle);
bark_speech(hayden, cute_face);
next_line(); //

//

//
