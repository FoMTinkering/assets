fun item_give_sequence(actor, item, count, start_location, offset) {
	var x = get_element_x(start_location);
	var y = get_element_y(start_location);
	x = x + offset;
	walk_slow(actor, x, y);
	face(actor, west);
	wait(0.25);
	ari_hold_item(item, count);
	wait(1);
	walk_slow(actor, start_location);
	face(actor, west);
}

fun item_give_sequence_hayden_watering_can() {
	sim {
		walk(hayden, fi_hayden_item_give);
		set_move_speed(hayden, fast_walk);
	}
	animate(hayden, ride_idle_1);
	face(hayden, east);
	wait(0.25);
	ari_hold_item(watering_can_worn, 1);
	wait(1);
}
fun item_give_sequence_hayden_turnips(start_location) {
	wait(1.5);
	ari_hold_item(seed_turnip, 3);
	wait(1);
	sim {
		walk(hayden, start_location);
		set_move_speed(hayden, fast_walk);
	}
	animate(hayden, ride_idle_1);
	face(hayden, east);
}

fun walk_slow_offset(actor, element, x, y) {
	var ex = get_element_x(element);
	var ey = get_element_y(element);
	walk_slow(actor, x + ex, y + ey);
}

