fun item_give_sequence(actor, start_location) {
	walk_slow(actor, tut_eiland_give);
	face(actor, west);
	wait(0.25);
	ari_hold_item(axe_worn);
	wait(0.5);
	walk_slow(actor, start_location);
	face(actor, west);
}

fun ari_swing() {
	play_sound("SoundEffects/Tools/AxeAndPickSwing");
	animate(ari, axe);
	free {
		wait(0.2);
		__chop_node(axe_worn, 146, 24);
	}
	ari_set_attachment(axe_worn);
	await_ari_animation();
	animate(ari, idle);
}

var eiland_is_chopping = false;

fun eiland_chop_sound() {
	if eiland_is_chopping == false {
		wait(1);
		return;
	}
	wait(0.35);
	play_sound("SoundEffects/Tools/AxeDamageTree");
	wait(0.75);
}

