	{
		//
		var camera_x = __get_element_x(dt4_camera_town_magic);
		var camera_y = __get_element_y(dt4_camera_town_magic);
		var target_x = __get_element_x(most_special_human);
		var target_y = __get_element_y(most_special_human);
		set_on_blackboard("command", "tri_loop");
		pan_camera(3, camera_x + (target_x - camera_x) / 2, camera_y + (target_y - camera_y) / 2);
	}
}
next_line(); //
close_textbox();
sim {
	{
		wait(1.5);
		next_line(); //
		set_on_blackboard("ambience_override", "Ambience/Void");
		refresh_ambience();
	}
	{
		if most_special_human == "adeline" or most_special_human == "eiland" {
			wait(0.5);
			face(most_special_human, west);
			wait(1.5);
			face(most_special_human, east);
			wait(1.5);
			face(most_special_human, south);
		} else if most_special_human == "celine" or most_special_human == "juniper" {
			wait(0.5);
			face(most_special_human, north);
			wait(1.5);
			face(most_special_human, south);
			wait(1.5);
			face(most_special_human, west);
		} else if most_special_human == "march" or most_special_human == "ryis" {
			wait(0.5);
			face(most_special_human, north);
			wait(1.5);
			face(most_special_human, south);
			wait(1.5);
			face(most_special_human, east);
		} else if most_special_human == "balor" or most_special_human == "hayden" or most_special_human == "reina" or most_special_human == "valen" {
			wait(0.5);
			face(most_special_human, west);
			wait(1.5);
			face(most_special_human, east);
			wait(1.5);
			face(most_special_human, north);
		}
	}
}

