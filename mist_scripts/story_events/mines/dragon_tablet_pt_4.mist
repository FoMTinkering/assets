place_actor(celine, east, dt4_celine_entrance);
place_actor(eiland, east, dt4_eiland_entrance);
place_actor(hayden, south, dt4_hayden_entrance);
place_actor(juniper, south, dt4_juniper_entrance);
place_actor(march, east, dt4_march_entrance);
place_actor(reina, east, dt4_reina_entrance);
place_actor(ryis, west, dt4_ryis_entrance);
place_actor(valen, north, dt4_valen_entrance);

//

camera_position(dt4_camera_town_1);

sim {
	{
		wait(0.25);
		fade_in(1);
		play_sound("SoundEffects/SpecialEvents/EarthquakeImpact");
	}
	{
		pan_camera(1.5, dt4_camera_town_2);
	}
	{
		wait(0.5);
		face(adeline, east);
		wait(0.5);
		free bark_speech(adeline, exclamation_mark);
	}
	{
		wait(0.6);
		face(eiland, west);
		wait(1.25);
		face(eiland, east);
	}
	{
		wait(0.7);
		face(balor, north);
		wait(0.5);
		free bark_speech(balor, question_mark);
		wait(0.5);
		face(balor, south);
	}
	{
		walk_slow(celine, dt4_celine_walk);
		face(celine, east);
		wait(0.75);
		face(celine, west);
		wait(1.25);
		face(celine, north);
	}
	{
		wait(0.75);
		face(valen, west);
	}
	{
		wait(0.9);
		face(hayden, east);
		wait(0.5);
		free bark_speech(hayden, sweat_drop);
	}
	{
		walk_slow(juniper, dt4_juniper_walk);
		face(juniper, south);
		free bark_speech(juniper, exclamation_mark);
	}
	{
		walk_slow(reina, dt4_reina_walk);
		face(reina, east);
		wait(1.2);
		face(reina, south);
		wait(1.25);
		face(reina, north);
	}
	{
		wait(1.4);
		face(ryis, north);
		wait(0.5);
		free bark_speech(ryis, question_mark);
	}
	{
		wait(1.5);
		face(march, south);
	}
}

set_on_blackboard("command", "earthquake_loop");
next_line(); //
sim {
	{
		wait(0.5);
		face(march, east);
	}
	{
		wait(0.6);
		face(ryis, east);
	}
	{
		wait(0.75);
		face(juniper, west);
	}
	{
