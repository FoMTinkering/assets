		face(hayden, north);
	}
	{
		wait(1.5);
		face(valen, north);
	}
	{
		wait(0.4);
		face(eiland, west);
	}
	{
		wait(1.75);
		face(reina, west);
	}
	{
		wait(1.65);
		face(celine, west);
	}
	{
		wait(0.5);
		face(adeline, south);
		wait(1);
		face(adeline, west);
		wait(1.5);
		face(adeline, east);
