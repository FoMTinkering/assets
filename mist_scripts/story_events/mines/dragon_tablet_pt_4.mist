			walk(juniper, dt4_juniper_start);
			set_move_speed(juniper, 1.6);
		}
		face(juniper, east);
		place_actor(juniper, east, dt4_juniper_sit);
		animate(juniper, sit);
	}
	{
		wait(1.25);
