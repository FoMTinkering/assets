			walk(march, dt4_march_start);
			set_move_speed(march, 1.3);
		}
		face(march, south);
		place_actor(march, south, dt4_march_sit);
		animate(march, sit);
	}
	{
		sim {
			walk(reina, dt4_reina_start);
