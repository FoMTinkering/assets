scene(caldarus_house);
place_actor(ari, north, cr_ari_entrance);
place_actor(caldarus, south, "Caldarus Wake Point");
animate(caldarus, eyes_closed);
anim_speed(caldarus, 0.2);
camera_position(cr_camera_1);
request_music_play("Music/Location Tracks/Deep Woods");

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		sim {
			walk(ari, cr_ari_start);
			set_move_speed(ari, 0.4);
		}
		face(ari, north);
		wait(0.25);
		face(ari, west);
		wait(1);
		free bark_speech(ari, question_mark);
		wait(0.5);
		face(ari, east);
		wait(1.25);
		free bark_speech(ari, exclamation_mark);
		wait(0.5);
		face(ari, north);
	}
	{
		wait(5.25);
		sim {
			{
				animate(caldarus, idle);
			}
			{
				wait(0.1);
				anim_speed(caldarus, 0.0);
			}
		}
		wait(0.25);
		free bark_speech(caldarus, exclamation_mark);
	}
	{
		pan_camera(4, cr_camera_2);
		wait(1.5);
		pan_camera(1, cr_camera_3);
	}
	{
		wait(6.75);
		next_line(); //
	}
}
close_textbox();
wait(0.1);
sim {
	{
		sim {
			walk(ari, cr_ari_run_1);
			set_move_speed(ari, 1.6);
		}
		face(ari, north);
		sim {
			walk(ari, cr_ari_run_2);
			set_move_speed(ari, 1.6);
		}
		face(ari, north);
		sim {
			walk(ari, cr_ari_run_3);
			set_move_speed(ari, 1.6);
		}
		face(ari, north);
		sim {
			walk(ari, cr_ari_bedside);
			set_move_speed(ari, 1.6);
		}
		face(ari, west);
	}
	{
		wait(2.25);
		face(caldarus, east);
	}
	{
		wait(0.5);
		pan_camera(2, cr_camera_4);
	}
}

next_line(); //
next_line(); //

//
next_line(); //
next_line(); //
close_textbox();
sim {
	{
		wait(1);
		face(caldarus, south);
		wait(0.5);
		sim {
			animate(caldarus, eyes_closed);
			anim_speed(caldarus, 0.2);
		}

	}
	{
		wait(2);
		next_line(); //
	}
}
close_textbox();
wait(1);
sim {
	{
		wait(1);
		sim {
			{
				animate(caldarus, idle);
			}
			{
				wait(0.05);
				anim_speed(caldarus, 0.0);
			}
		}
		wait(0.5);
		face(caldarus, east);
	}
	{
		next_line(); //
	}
}
close_textbox();
wait(0.25);
free bark_speech(ari, cute_face);
wait(0.75);
free bark_speech(caldarus, cute_face);
wait(1);
sim {
	{
		wait(0.75);
		face(caldarus, south);
	}
	{
		next_line(); //
	}
}
sim {
	{
		wait(0.75);
		face(caldarus, east);
	}
	{
		next_line(); //
	}
}
close_textbox();
free bark_speech(ari, cute_face);
wait(1);
face(caldarus, south);
wait(1);
anim_speed(caldarus, 0.2);
animate(caldarus, eyes_closed);
wait(1);
anim_speed(ari, 0.2);
animate(ari, action);
wait(0.3);
freeze_ari();
wait(1);
fade_out(2);
