scene(water_seal);
place_actor(ari, north, ws_ari_entrance);
camera_position(ws_camera_1);
request_music_play("Music/Events/TheSeal");

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		sim {
			walk(ari, ws_ari_start);
			set_move_speed(ari, 0.4);
		}
		face(ari, north);
	}
	{
		wait(2);
	}
	pan_camera(4, ws_camera_2);
}
next_line(); //
sim {
	{
		free bark_speech(ari, exclamation_mark);
		wait(0.25);
		face(ari, west);
		wait(0.5);
		face(ari, east);
		wait(0.5);
		face(ari, west);
		wait(1);
		face(ari, north);
	}
	{
		next_line(); //
	}
	//
	//
	//
	//
	//
}
close_textbox();
wait(1);
sim {
	{
		walk_slow(ari, ws_ari_tablet);
		face(ari, north);
		wait(1);
		animate(ari, action);
		wait(0.2);
		freeze_ari();
	}
	pan_camera(4, ws_camera_3);
	{
		wait(3);
		next_line(); //
	}
}
close_textbox();
animate(ari, idle);
wait(1);
animate(ari, action);
wait(1.5);
animate(ari, idle);
wait(0.5);
ari_hold_item(water_tablet_rubbing);
wait(1);
sim {
	walk(ari, ws_ari_back);
	set_move_speed(ari, 0.4);
}
face(ari, north);
wait(1);
fade_out(2);
