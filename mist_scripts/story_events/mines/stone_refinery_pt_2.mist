var keep_swinging_ari = true;

fun ari_swing() {
	if keep_swinging_ari == false {
    return;
	}
	play_sound("SoundEffects/Tools/AxeAndPickSwing");
	free {
		wait(0.25);
		play_sound("SoundEffects/Tools/PickDamageRock");
	}
	animate(ari, axe);
	ari_set_attachment(pick_axe_worn);
	await_ari_animation();
	animate(ari, idle);
	wait(0.5);
	ari_swing();
}

var errol_is_picking = true;

fun errol_pick_sound() {
	if errol_is_picking == false {
		return;
	}
	play_sound("SoundEffects/SpecialEvents/EilandPickDamageRock");
	wait(0.75);
	errol_pick_sound();
}
var olric_is_picking = true;

fun olric_pick_sound() {
	if olric_is_picking == false {
		return;
	}
	play_sound("SoundEffects/SpecialEvents/EilandPickDamageRock");
	wait(0.85);
	olric_pick_sound();
}

