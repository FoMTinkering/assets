scene(earth_seal);
place_actor(ari, north, es_ari_entrance);
camera_position(es_camera_1);
request_music_play("Music/Events/TheSeal");

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		sim {
			walk(ari, es_ari_start);
			set_move_speed(ari, 0.4);
		}
		face(ari, north);
	}
	{
		wait(2);
	}
	pan_camera(4, es_camera_2);
}
sim {
	{
		wait(1);
		free bark_speech(ari, exclamation_mark);
	}
	{
		wait(0.5);
		place_actor("seridia", "south", "es_priestess");
		set_shadow_enabled("seridia", false);
		fade_npc_alpha("seridia", 0.0, 0.5, 180);
	}
	{
		pan_camera(2, es_camera_priestess);
	}
}
wait(2);
next_line(); //
next_line(); //
next_line(); //
close_textbox();
fade_npc_alpha("seridia", 0.5, 0.0, 180);
wait(1);
sim {
	{
		wait(1.5);
		walk_slow(ari, es_ari_tablet);
		face(ari, north);
	}
	{
		wait(0.5);
		pan_camera(4, es_camera_3);
	}
	{
		wait(2);
		remove_actor("seridia");
	}
}
wait(1);
animate(ari, action);
wait(1.5);
animate(ari, idle);
wait(0.5);
ari_hold_item(earth_tablet_rubbing);
wait(1);
sim {
	{
		sim {
			walk(ari, es_ari_back);
			set_move_speed(ari, 0.4);
		}
		face(ari, north);
	}
	{
		pan_camera(1.5, es_ari_back);
	}
}

face(ari, north);
wait(0.5);
fade_out(2);
