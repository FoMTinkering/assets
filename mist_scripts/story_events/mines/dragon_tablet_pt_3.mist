			create_animation(spr_fx_poof1_dirt_once, dt3_poof, 0, 0, 0, -500);
			play_sound("SoundEffects/SpecialEvents/TransitionBack");
			equip_dragonsworn_armor();
			animate(ari, idle);
		}
		wait(2);
		create_unique_renderer();
		set_on_blackboard("command", "make_ari_purple");
		wait(2);
		setup_prop(dt3_void_sight);
		free fade_prop_alpha(dt3_void_sight, 0.0, 1.0, 120);
		wait(1);
		free bark_speech(juniper, exclamation_mark);
		free bark_speech(eiland, exclamation_mark);
		wait(1.5);
	}
	{
		wait(3);
		pan_camera(3, dt3_camera_15);
	}
}
next_line(); //
