

fun repeat_until_call_for_help() {
	if get_response() == 1 {
		repeat_line();
		repeat_until_call_for_help();
	}
}


var fade_over = false;

scene(fire_seal);

create_unique_renderer();

//
fade_out(2);
place_actor(ari, north, "ari_look");
face(ari, north);
play_sound("SoundEffects/SpecialEvents/CaldarusStatueFix");
trigger_scene_object_removals();
wait(1.5);
play_sound("SoundEffects/SpecialEvents/Premonition");
wait(1);
request_music_play("Music/Events/TheSeal");
fade_in(2);
wait(0.5);
place_actor(seridia, south, fs_priestess);
set_shadow_enabled(seridia, false);
play_sound("SoundEffects/NPCs/SeridiaFadeOut");
fade_npc_alpha(seridia, 0.0, 0.5, 180);
wait(1);
free pan_camera(3, fs_camera_priestess);
wait(2);
next_line(); //
close_textbox();


//
free request_music_stop(1);
free {
	sim {
		shake_camera(0.3);
		play_sound("SoundEffects/SpecialEvents/EarthShake1");
	}
	wait(0.5);
	sim {
		shake_camera(0.6);
		play_sound("SoundEffects/SpecialEvents/EarthShake2");
	}
	wait(0.8);
	sim {
		shake_camera(0.9);
		play_sound("SoundEffects/SpecialEvents/EarthShakeLong");
	}
}

wait(0.25);
free bark_speech(seridia, exclamation_mark);
free bark_speech(ari, exclamation_mark);
wait(1.5);
pan_camera(1, bfs_camera_scroll);
sim {
	play_sound("SoundEffects/SpecialEvents/ScrollRaise");
	set_on_blackboard("command", "raise_scroll");
	{
		wait(0.3);
		request_music_play("Music/Events/ThemeOfDarkness");
	}
}


sim {
	{
		wait(0.5);
		face(ari, east);
	}
	{
		wait(0.75);
		face(seridia, east);
	}
}
wait(1);

sim {
	{
		pan_camera(1, fs_camera_priestess);
	}
	{
		wait(0.25);
		face(seridia, south);
	}
	{
		wait(1);
		face(ari, north);
	}
	{
		wait(0.75);
		next_line(); //
		next_line(); //
		next_line(); //
	}
}

close_textbox();

sim {
	{
		play_sound("SoundEffects/NPCs/SeridiaFadeOut");
		fade_npc_alpha(seridia, 0.5, 0.0, 60);
		wait(1);
		remove_actor(seridia);
	}
	{
		wait(1);
		pan_camera(1.5, bfs_ari_escape);
	}
	{
		wait(1.75);
		sim {
			make_next_ari_walk_use_run();
			walk(ari, bfs_ari_escape);
			set_move_speed(ari, 2);
		}
	}
	{
		wait(2);
		sim {
			set_on_blackboard("command", "unfurl_scroll");
			{
				wait(0.1);
				play_sound("SoundEffects/SpecialEvents/ScrollAttack");
			}
		}

	}
}

//
animate(ari, idle);
shake_camera(0.5);
sim {
	{
		wait(0.2);
		set_on_blackboard("command", "start_magic_loop");
	}
	set_on_blackboard("command", "ari_paralysis");
	play_sound("SoundEffects/Ari/TakeElectricDamage");
}
wait(0.25);
free bark_speech(ari, exclamation_mark);

wait(2);

play_sound("SoundEffects/Ari/TakeDamage");
show_menu(vitals);
if __get_ari_health() >= 10 {
	__set_ari_health_direct(__get_ari_health() / 2);
}
if __get_ari_stamina() >= 10 {
	__set_ari_stamina_direct(__get_ari_stamina() / 2);
}
set_on_blackboard("command", "fake_hurt_ari");
await_flag_from_blackboard("hurt_done");
set_on_blackboard("hurt_done", -1);
set_on_blackboard("command", "make_ari_blue");
animate(ari, faint);
freeze_ari_on_last_frame();
await_ari_animation();

wait(0.25);
free bark(ari, ellipses);
wait(2);

__set_ari_health_direct(1);
__set_ari_stamina_direct(1);
set_on_blackboard("command", "fake_hurt_ari");
await_flag_from_blackboard("hurt_done");
set_on_blackboard("command", "make_ari_blue");

wait(1.5);
hide_menu(vitals);
next_line(); //
repeat_until_call_for_help();
next_line(); //

close_textbox();

//
set_on_blackboard("command", "bring_in_black");
play_sound("SoundEffects/SpecialEvents/CaldarusAppear");
wait(0.1);
set_on_blackboard("command", "stop_magic_loop");
wait(1.9);

//

sim {
	pan_camera(3, bfs_camera_caldarus_dragon);
	{
		wait(1);
		set_on_blackboard("command", "bring_in_caldarus");
		wait(4);
	}
	{
		request_music_play("caldarus");
	}
}


__raise_textbox();
place_actor(caldarus, north, fs_ari_entrance);
set_outfit(caldarus, dragon_statue);
next_line(); //
close_textbox();
wait(0.5);
free bark_speech(ari, ellipses);
wait(2);
next_line(); //
close_textbox();

//
