	{
		pan_camera(2, bfs_camera_ari);
	}
	{
		wait(0.25);
		animate(ari, idle);
		wait(0.5);
		face(ari, west);
		wait(0.5);
		face(ari, east);
		wait(1);
		face(ari, north);
		wait(0.25);
		free bark_speech(ari, exclamation_mark);
		wait(1);
	}
}


//
next_line(); //
close_textbox();
sim {
	{
		wait(4.5);
		next_line(); //

	}
	{
		wait(1);
		sim {
			walk(caldarus, bfs_caldarus_start);
			set_move_speed(caldarus, 0.4);
		}
		face(caldarus, west);
		animate(caldarus, eyes_closed);
		wait(1);
		free bark_speech(caldarus, ellipses);
	}
	{
