	}
}

sim {
	{
		wait(0.25);
		animate(caldarus, idle);
		wait(0.5);
		face(caldarus, south);
	}
	{
		next_line(); //
	}
}
close_textbox();
fade_over = true;
wait(1);
animate(caldarus, spell_cast);
set_on_blackboard("command", "caldarus_purple");
play_sound("SoundEffects/SpecialEvents/CaldarusMagicSimple");
wait(1.5);
sim {
	play_sound("SoundEffects/SpecialEvents/CaldarusDisappear");
	fade_npc_alpha(caldarus, 1.0, 0.0, 6);
	{
		wait(0.1);
		create_animation(spr_fx_poof1_essence_once, bfs_caldarus_poof, 0, 0, -15, -500);
	}

}
wait(0.1);
remove_actor(caldarus);
wait(1);
pan_camera(2, ari);
show_menu(vitals);

