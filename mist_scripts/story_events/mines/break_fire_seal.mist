wait(2);

next_line(); //

close_textbox();

wait(0.25);

//

sim {
	{
		pan_camera(4, bfs_camera_ari);
	}
	{
		wait(1.5);
		setup_prop(db_spell, -1000);
		free fade_prop_alpha(db_spell, 0.0, 1.0, 120);
		wait(3);
		free fade_prop_alpha(db_spell, 1.0, 0.0, 60);
		wait(1);
		destroy_prop(db_spell);
	}
	{
		wait(2);
		play_sound("SoundEffects/Objects/UseChickenStatue");
		create_animation(spr_npc_effect_heal, bfs_magic_animation, 0, 0, 0, -1000);
	}
}

next_line(); //
close_textbox();
wait(2);
next_line(); //
close_textbox();
wait(1);
next_line(); //

//

close_textbox();
sim {
	{
		wait(1);
		pan_camera(2, bfs_camera_caldarus_dragon);
	}
	{
		wait(3.25);
		next_line(); //
		next_line(); //
	}
}
close_textbox();

wait(1);
play_sound("SoundEffects/SpecialEvents/CaldarusTransformation");
set_on_blackboard("command", "pulse_dragon");
wait(3.5);
set_on_blackboard("command", "flash");
await_flag_from_blackboard("flash_in");
set_outfit(caldarus, spring);
set_on_blackboard("draw_cal_over_black", true);
place_actor(caldarus, south, bfs_caldarus_entrance);
set_on_blackboard("command", "overlay_caldarus");
raise_actor(caldarus);
await_flag_from_blackboard("flash_done");
wait(2);
pan_camera(2, bfs_camera_ari);
next_line(); //
close_textbox();

//
sim {
	{
		wait(0.25);
		pan_camera(4, bfs_camera_caldarus_dragon);
	}
	{
		sim {
			{
				wait(1.3);
				lower_actor(caldarus);
			}
			{
				wait(1.5);
				set_on_blackboard("command", "remove_black");
			}

		}

	}
	{
		wait(0.25);
		animate(caldarus, spell_cast);
		play_sound("SoundEffects/SpecialEvents/CaldarusMagicFull");
		set_on_blackboard("command", "caldarus_purple");
		wait(1.1);
		fade_npc_alpha(caldarus, 1.0, 0, 15);
		wait(0.7);
		set_on_blackboard("command", "no_caldarus_purple");
		sim {
			{
				wait(0.1);
				fade_npc_alpha(caldarus, 0.0, 1.0, 15);
			}
			play_sound("SoundEffects/Entrances/Teleport");
			create_animation(spr_fx_poof1_essence_once, bfs_caldarus_poof_2, 0, 0, 0, -500);
		}
		wait(0.3);
		animate(caldarus, idle);
	}
}
wait(1.5);
sim {
	{
		pan_camera(1.5, bfs_camera_scroll_destruction);
	}
	{
		sim {
			walk(caldarus, bfs_caldarus_scroll_destruction);
			set_move_speed(caldarus, 1.3);
		}
		face(caldarus, east); //
	}
}

//
animate(caldarus, spell_cast);
play_sound("SoundEffects/SpecialEvents/CaldarusMagicSimple");
wait(0.25);
set_on_blackboard("command", "start_caldarus_spell");
wait(2);
set_on_blackboard("command", "destroy_scroll");
play_sound("SoundEffects/Ari/DragonBreathStart");
wait(1.25);
set_on_blackboard("command", "free_ari");
