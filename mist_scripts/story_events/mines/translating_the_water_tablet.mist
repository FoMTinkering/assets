}
close_textbox();
sim {
	{
		wait(0.5);
		free bark_speech(eiland, annoyed);
	}
	{
		wait(4);
		next_line(); //
	}
}
sim {
	{
		wait(1);
		face(juniper, south);
	}
	{
		next_line(); //
		next_line(); //
	}
}

