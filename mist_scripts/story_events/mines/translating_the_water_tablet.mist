}
close_textbox();
sim {
	{
		wait(1);
		request_music_stop(2);
		wait(0.5);
		request_music_play(caldarus);
	}
	{
		wait(1);
		face(juniper, north);
	}
	{
		wait(1.5);
		pan_camera(6, twt_camera_5);
	}
	{
		wait(2);
		next_line(); //
		next_line(); //
		next_line(); //
		next_line(); //
		next_line(); //
	}
}
close_textbox();
sim {
	{
		//
		//
	}
	{
		wait(0.5);
		pan_camera(2, twt_camera_4);
	}
	{
		wait(0.5);
		face(juniper, south);
	}
	{
		wait(0.5);
		next_line(); //
		next_line(); //
		next_line(); //
	}
}
sim {
	{
		wait(0.5);
		face(eiland, west);
		wait(0.5);
		face(ari, east);
	}
	{
		next_line(); //
	}
}

//

if get_response() == 0 {
	next_line(); //
} else {
	sim {
		{
			wait(2);
			face(ari, north);
			wait(0.5);
			face(eiland, north);
		}
		{
			next_line(); //
		}
	}
}
sim {
	{
		wait(0.5);
		face(eiland, north);
		wait(1);
		face(eiland, west);
	}
	{
		wait(2);
		face(ari, east);
	}
	{
