scene(bathhouse_bedroom);
place_actor(juniper, south, "Desk Stool");
place_actor(ari, north, tet_ari_entrance);
setup_prop(tet_bathhouse_bedroom_earth_tablet);
camera_position(tet_camera_1);
request_music_play("Music/Events/DragonCutscene");

sim {
	fade_in(2);
	{
		wait(1.5);
		next_line(); //
	}
	{
		wait(1);
		face(juniper, south);
	}
}
close_textbox();
wait(0.25);
face(juniper, north);
wait(2);
next_line(); //
close_textbox();
wait(1.5);
free bark_speech(ari, ellipses);
wait(2);
next_line(); //
//
sim {
	next_line(); //
	{
		wait(1);
		face(juniper, south);
		wait(2);
		face(juniper, north);
	}
}
close_textbox();
wait(0.5);
free bark_speech(ari, annoyed);
wait(0.5);
sim {
	{
		walk_slow(ari, tet_ari_inspect);
		face(ari, west);
		wait(1);
		animate(ari, action);
	}
	{
		wait(3);
		next_line(); //
		close_textbox();
	}
}
sim {
	{
		wait(0.5);
		face(juniper, south);
	}
	{
		wait(0.25);
		free bark_speech(ari, exclamation_mark);
		animate(ari, idle);
		wait(0.5);
		walk(ari, tet_ari_entrance);
		face(ari, north);
	}
	{
		next_line(); //
		next_line(); //
	}
}
sim {
	{
		face(juniper, north);
		wait(0.5);
		destroy_prop(tet_bathhouse_bedroom_earth_tablet);
		wait(0.5);
		face(juniper, south);
		walk_slow(juniper, tet_juniper_start);
		face(juniper, west);
	}
	pan_camera(3, tet_camera_2);
	{
		next_line(); //
	}
	{
		wait(2);
		face(ari, east);
	}
}
sim {
	{
		wait(0.5);
		face(juniper, east);
	}
	{
		next_line(); //
	}
}
sim {
	{
		wait(1);
		face(juniper, west);
	}
	{
		next_line(); //
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(0.25);
sim {
	{
		walk(juniper, tet_exit);
	}
	{
		wait(1);
		face(ari, south);
		wait(0.5);
		walk_slow(ari, tet_exit);
	}
	{
		wait(1);
		fade_out(2);
	}
	{
		wait(1);
		pan_camera(3, tet_camera_3);
	}
}

scene(celines_room);
camera_position(tet_camera_4);
place_actor(ari, north, tet_ari_cr_entrance);
place_actor(celine, south, "ArmChair Seat");
animate(celine, book_sit);
