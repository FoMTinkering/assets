scene(narrows);
place_actor(errol, east, utm2_errol_entrance);
place_actor(eiland, west, utm2_eiland_entrance);
place_actor(ari,west, utm2_ari_entrance);
camera_position(utm2_camera_1);
request_music_play("Music/Events/DragonCutscene");

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		free bark_speech(errol, archaeology);
		wait(1);
		free bark_speech(eiland, annoyed);
		wait(1);
		free bark_speech(errol, exclamation_mark);
		wait(0.25);
		free bark_speech(eiland, exclamation_mark);
		face(errol, south);
		wait(0.25);
		face(eiland, south);
	}
	{
		wait(3);
		walk_slow(errol, utm2_errol_start);
		face(errol, south);
	}
	{
		wait(3.25);
		walk_slow(eiland, utm2_eiland_start);
		face(eiland, south);
	}
	{
		wait(3);
		next_line(); //
	}
	{
		walk_slow(ari, utm2_ari_start);
		face(ari, north);
	}
	pan_camera(4, utm2_camera_2);
}
sim {
	{
		wait(1);
		face(errol, north);
		wait(1);
		face(errol, east);
	}
	{
		wait(2.5);
		face(eiland, west);
	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(1);
free bark_speech(errol, ellipses);
wait(1);
face(errol, south);
wait(1.25);
free bark_speech(errol, sweat_drop);
wait(0.5);
sim {
	{
		next_line(); //
		next_line(); //
	}
	{
		wait(0.5);
		face(errol, east);
	}
}
sim {
	{
		wait(0.5);
		face(errol, south);
	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(0.5);
sim {
	{
		walk_slow(errol, utm2_errol_mines);
		face(errol, north);
	}
	{
		wait(1);
		face(eiland, north);
	}
	{
		wait(0.25);
		pan_camera(2.5, utm2_camera_3);
	}
}
wait(0.5);
next_line(); //
close_textbox();
//
fade_out(1);
play_sound("SoundEffects/SpecialEvents/ErrolBreakMinesDoor");
trigger_scene_object_removals();
wait(4);
sim {
	fade_in(1);
	pan_camera(2.5, utm2_camera_2);
	{
		face(errol, south);
		wait(0.25);
		walk_slow(errol, utm2_errol_start);
		face(errol, south);
	}
	{
		wait(1);
		face(eiland, west);
	}
	{
		wait(1);
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free sim {
	{
		wait(0.25);
		face(errol, east);
		wait(1);
		face(errol, north);
	}
	{
		walk_slow(eiland, utm2_scene_exit);
		face(eiland, north);
		remove_actor(eiland);
	}
	{
		wait(1.25);
		walk_slow(ari, utm2_scene_exit);
		face(ari, north);
		set_ari_to_idle();
	}
	{
		wait(0.5);
		sim {
			fade_out(2);
			pan_camera(3, utm2_camera_3);
			request_music_stop(2);
		}
	}
}
wait(3);

//
scene(mines_entry);
place_actor(eiland, north, utm2_eiland_mines_entrance);
place_actor(ari, north, utm2_ari_mines_entrance);
camera_position(utm2_camera_4);
request_music_play("Music/Location Tracks/MinesEntry");

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		walk_slow(eiland, utm2_eiland_mines_start);
		face(eiland, north);
	}
	{
		walk_slow(ari, utm2_ari_mines_start);
		face(ari, north);
	}
	pan_camera(3, utm2_camera_6);
	{
		wait(2);
		next_line(); //
	}
}
sim {
	pan_camera(2, utm2_camera_7);
	{
		next_line(); //
	}
	{
		wait(0.5);
		face(eiland, east);
		wait(0.5);
		face(ari, east);
	}
}
sim {
	pan_camera(2, utm2_camera_5);
	{
		close_textbox();
		wait(0.5);
		face(ari, west);
		wait(0.5);
		free bark_speech(ari, question_mark);
		wait(1);
		free bark_speech(eiland, question_mark);
		wait(1);
		face(eiland, north);
		wait(0.5);
	}
}

sim {
	//
	//
	//
	//
	{
		walk_slow(eiland, utm2_eiland_mines_pause);
		face(eiland, west);
		free bark_speech(eiland, exclamation_mark);
		sim {
			walk(eiland, utm2_eiland_mines_search);
			set_move_speed(eiland, 1.25);
		}
		face(eiland, north);
	}
	{
		pan_camera(3, utm2_camera_8);
	}
	{
		wait(3);
		next_line(); //
		//
	}
	{
		wait(2);
		walk(ari, utm2_ari_mines_statue);
		face(ari, north);
	}
}


sim {
	pan_camera(2, utm2_camera_9);
	{
		wait(0.25);
		face(eiland, south);
	}
	{
		next_line(); //
	}
}

sim {
	{
		wait(0.5);
		face(eiland, north);
	}
	{
		next_line(); //
	}
}
sim {
	{
		wait(0.5);
		face(eiland, south);
	}
	{
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(ari, cute_face);
wait(0.5);
free bark_speech(eiland, cute_face);
wait(0.5);
next_line(); //
close_textbox();
sim {
	{
		sim {
			walk(eiland, utm2_eiland_mines_search_extra);
			set_move_speed(eiland, 1.2);
		}
		face(eiland, south);
		sim {
			free {
				wait(2);
				fade_npc_alpha(eiland, 1.0, 0.0, 60);
			}
			walk(eiland, utm2_eiland_mines_search_extra_extra);
			set_move_speed(eiland, 1.2);
		}
		sim {
			walk(eiland, utm2_eiland_mines_search_extra_extra_extra);
			set_move_speed(eiland, 1.2);
		}
		face(eiland, east);
		sim {
			walk(eiland, utm2_eiland_mines_exit);
			set_move_speed(eiland, 1.2);
		}
		face(eiland, south);
		remove_actor(eiland);
	}
	{
		wait(0.75);
		face(ari, east);
		wait(0.5);
		face(ari, south);
		wait(1);
		face(ari, north);
	}
	{
		wait(2);
		free pan_camera(5, utm2_camera_8);
	}
	{
		wait(4);
		fade_out(2);
	}
}
wait_one_tick();
