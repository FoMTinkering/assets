	{
		walk(dell, c6h_ari_entrance);
		remove_actor(dell);
	}
	{
		wait(0.75);
		face(celine, north);
		animate(celine, action);
		wait(0.5);
		destroy_prop(c6h_celine_pot);
		animate(celine, idle);
		free walk_slow(celine, c6h_celine_exit);
	}
	{
		wait(0.5);
		walk_slow(ari, c6h_ari_start);
	}
	{
		wait(0.5);
		fade_out(2);
	}
	{
		wait(0.5);
		pan_camera(2, c6h_camera_2);
	}
}
wait(1);
scene(town);
camera_position(c6h_camera_4);
place_actor(ari, north, c6h_ari_town_entrance);
