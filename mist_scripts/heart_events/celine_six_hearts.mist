scene(celines_room);
camera_position(c6h_camera_1);
place_actor(ari, north, c6h_ari_entrance);
place_actor(celine, south, "ArmChair Seat");
animate(celine, book_sit);
request_music_play(celine);
setup_prop(c6h_celine_pot);
//
toggle_object_visibility("obj_celine_pot");

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		wait(1);
		free bark_speech(celine, ellipses);
		wait(3);
		free bark_speech(celine, exclamation_mark);
		wait(0.5);
		animate(celine, sit);
		walk(celine, c6h_celine_entrance);
		face(celine, south);
	}
	{
		wait(3.5);
		walk_slow(ari, c6h_ari_start);
		face(ari, north);
	}
	{
		wait(3.5);
		pan_camera(2, c6h_camera_2);
	}
	{
		wait(5);
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(ari, music);
wait(1);
free bark_speech(celine, cute_face);
wait(1.5);
sim {
	{
		walk_slow(celine, c6h_celine_start);
		face(celine, north);
	}
	{
