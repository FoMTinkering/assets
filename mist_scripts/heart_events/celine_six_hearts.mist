sim {
	free {
		sim {
			walk(dell, c6h_dell_town_walk);
			set_move_speed(dell, 1.2);
		}
		face(dell, north);
		sim {
			walk(dell, c6h_dell_town_exit);
			set_move_speed(dell, 1.2);
		}
		face(dell, north);
		use_door(dell);
	}
	{
		wait(0.5);
		face(ari, north);
		wait(1.5);
		face(ari, south);
	}
	{
		wait(2.5);
		next_line(); //
