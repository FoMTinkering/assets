		face(ari, west);
	}
	{
		walk_slow(dell, c6h_dell_town_start);
		face(dell, east);
		next_line(); //
	}
	free {
		walk_slow(celine, c6h_celine_town_pause);
		face(celine, north);
		free bark_speech(celine, exclamation_mark);
	}
	{
		pan_camera(3, c6h_camera_5);
	}
}

