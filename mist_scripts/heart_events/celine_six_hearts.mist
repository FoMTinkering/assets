	{
		next_line(); //
	}
}

sim {
	{
		wait(1.5);
		face(celine, east);
	}
	{
		next_line(); //
	}
}
if get_response() == 0 {
	sim {
		{
			wait(0.75);
			face(ari, west);
		}
		{
			next_line(); //
		}
	}
} else {
	sim {
		{
			wait(1.5);
			face(ari, west);
		}
		{
			next_line(); //
		}
	}
}
close_textbox();
wait(0.25);
free bark_speech(dell, yum);
wait(1);
sim {
	{
		sim {
			walk(dell, c6h_dell_sprint_1);
			set_move_speed(dell, 2);
		}
		face(dell, east);
		sim {
			walk(dell, c6h_dell_sprint_2);
			set_move_speed(dell, 2);
		}
		face(dell, west);
		sim {
			walk(dell, c6h_dell_sprint_1);
			set_move_speed(dell, 2);
		}
		face(dell, east);
		sim {
			walk(dell, c6h_dell_sprint_2);
			set_move_speed(dell, 2);
		}
		face(dell, west);
		sim {
			walk(dell, c6h_dell_entrance);
			set_move_speed(dell, 2);
		}
		face(dell, north);
	}
	{
		wait(0.5);
		free bark_speech(celine, exclamation_mark);
		free bark_speech(ari, exclamation_mark);
		wait(0.5);
		face(ari, south);
		face(celine, south);
	}
	{
		wait(1);
		next_line(); //
	}
}
