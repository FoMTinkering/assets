
scene(manor_house_entry);
camera_position(a8h_camera_1);
place_actor(ari, north, a8h_ari_entrance);
request_music_stop(2);
sim {
    {
        wait(0.25);
        fade_in(2);
        wait(9.5);
        fade_out(2);
    }
    {
        walk_slow(ari, a8h_ari_start);
        face(ari, north);
        wait(1.5);
        free bark_speech(ari, question_mark);
        wait(0.5);
        face(ari, east);
        wait(1);
        face(ari, west);
        wait(3);
        free bark_speech(ari, ellipses);
        wait(2);
        walk_slow(ari, a8h_ari_exit);
    }
    {
        pan_camera(3.5, a8h_camera_2);
        wait(2.75);
        pan_camera(1, a8h_camera_3);
        wait(1);
        pan_camera(1, a8h_camera_2);
        wait(1.75);
        pan_camera(3, a8h_camera_4);
    }
}

