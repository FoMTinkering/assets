fun item_give_sequence(actor, start_location) {
	walk_slow(actor, m2h_march_desk);
	face(actor, north);
	wait(0.5);
	walk_slow(actor, m2h_march_forward_2);
	face(actor, west);
	wait(0.25);
	ari_hold_item(hoe_copper);
	wait(1);
	walk_slow(actor, start_location);
	face(actor, south);
}

scene(blacksmith_store);
camera_position(m2h_camera_1);
place_actor(ari, north, m2h_ari_entrance);
place_actor(march, north, "Workbench Stool");
animate(march, sit);
request_music_play(march);

sim {
	fade_in(2);
	pan_camera(3, m2h_camera_2);
	{
		walk_slow(ari, m2h_ari_start);
		face(ari, north);
	}
	{
		wait(2.5);
		free bark_speech(march, exclamation_mark);
		wait(0.5);
		face(march, south);
	}
	{
		wait(3.25);
		next_line(); //
	}
}

sim {
	{
		animate(march, idle);
		walk_slow(march, m2h_march_start);
		face(march, south);
	}
	{
		next_line(); //
		//
		next_line(); //
		next_line(); //
	}
}
close_textbox();
free bark_speech(ari, question_mark);
wait(1);

sim {
	pan_camera(5, m2h_camera_3);
	{
		wait(0.5);
		sim {
			walk(march, m2h_march_forward_1);
			set_move_speed(march, 0.4);
		}
		face(march, south);
	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(march, angry);
wait(1);
sim {
	{
		walk_slow(march, m2h_march_side_brood);
		face(march, east);
	}
	{
		next_line(); //
	}
}
if get_response() == 1 {
	sim {
		{
			sim {
				walk(ari, m2h_ari_retort);
				set_move_speed(ari, 0.4);
			}
			face(ari, east);
		}
		{
			free bark_speech(march, exclamation_mark);
			wait(0.75);
			face(march, west);
		}
		{
			//
			next_line(); //
		}
	}
} else {
	sim {
		{
			sim {
				walk(ari, m2h_ari_retort);
				set_move_speed(ari, 1.2);
			}
			face(ari, east);
		}
		{
			wait(0.5);
			face(march, west);
		}
		{
			//
			next_line(); //
		}
	}
}

close_textbox();
sim {
	bark_speech(march, ellipses);
	bark_speech(ari, ellipses);
}
wait(0.5);
sim {
	{
		wait(0.5);
		item_give_sequence(march, m2h_march_side_brood);
		face(march, west);
	}
	{
		next_line(); //
		next_line(); //
		next_line(); //
	}
}

free {
		wait(1);
		walk_slow(march, "Workbench Stool");
		face(march, north);
		animate(march, sit);
	}
next_line(); //
close_textbox();
wait(0.5);
free bark_speech(ari, annoyed);
wait(1);
sim {
	fade_out(2);
	pan_camera(3, m2h_camera_1);
	{
		walk_slow(ari, m2h_ari_entrance);
		face(ari, south);
	}
}
wait_one_tick();



