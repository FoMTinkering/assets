var keep_swinging_ari = true;

fun ari_swing() {
	if keep_swinging_ari == false {
		return;
	}
	play_sound("SoundEffects/Tools/AxeAndPickSwing");
	animate(ari, axe);
	free {
		wait(0.25);
		__pick_node(pick_axe_gold, 28, 40);
	}
	ari_set_attachment(pick_axe_worn);
	await_ari_animation();
	animate(ari, idle);
	wait(0.5);
}
