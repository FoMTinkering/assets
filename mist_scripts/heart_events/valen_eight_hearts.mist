	free bark_speech(valen, heart);
	wait(0.5);
	free bark_speech(ari, heart);
	wait(2);
}
next_line(); //
next_line(); //
next_line(); //
close_textbox();
wait(0.5);
free bark_speech(ari, cute_face);
wait(0.5);
free bark_speech(valen, cute_face);
wait(2);

//
sim {
	{
		wait(0.75);
		place_actor(ari, west, v8h_ari_cf2_stand);
		animate(ari, idle);
	}
	{
		place_actor(valen, east, v8h_valen_cf2_stand);
		animate(valen, idle);
	}
	{
		wait(0.5);
		next_line(); //
		next_line(); //
	}
	{
		pan_camera(1.5, v8h_camera_26);
	}
}
if get_response() == 0 {
	next_line(); //
	close_textbox();
	wait(0.5);
	free bark_speech(ari, cute_face);
	free bark_speech(valen, cute_face);
	wait(1);
	fade_out(3);
} else {
	checkpoint("kiss");
	sim {
		{
			wait(2);
			sim {
				walk(valen, v8h_valen_cf2_kiss);
				set_move_speed(valen, 0.3);
			}
			face(valen, east);
		}
		{
			wait(2);
			pan_camera(1.5, v8h_camera_27);
		}
		{
			next_line(); //
		}
	}
	close_textbox();
	wait(0.25);
	kiss_npc(valen, true, 1);
	wait(1);
	fade_out(3);
}
