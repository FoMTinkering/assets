scene(celines_room);
camera_position(c8h_camera_1);
place_actor(ari, north, c8h_ari_entrance);
place_actor(celine, north, c8h_celine_entrance);
animate(celine, action);
request_music_play(celine);
setup_prop(c8h_flower_pot);
setup_prop(c8h_sandwiches);
setup_prop(c8h_basket_open);
toggle_object_visibility("obj_celine_pot");
toggle_asset_visibility("spr_celinecottage_basket_spring");

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		walk_slow(ari, c8h_ari_start);
		face(ari, east);
	}
	{
		pan_camera(3, c8h_camera_2);
	}
	{
		wait(2);
		free bark_speech(celine, exclamation_mark);
		wait(0.5);
		animate(celine, idle);
		face(celine, west);
	}
	{
		wait(3);
		next_line(); //
		next_line(); //
	}
}
close_textbox();
sim {
	{
		wait(1.25);
		walk_slow(ari, c8h_ari_forward);
		face(ari, east);
	}
	{
		walk_slow(celine, c8h_celine_mid);
		face(celine, south);
		walk_slow(celine, c8h_celine_start);
		face(celine, east);
		animate(celine, action);
		wait(0.5);
		animate(celine, idle);
		face(celine, west);
	}
	{
		pan_camera(2, c8h_camera_3);
	}
	{
		wait(1);
		next_line(); //
		next_line(); //
	}
}

//

if get_response() == 0 {
	sim {
		{
			wait(0.75);
