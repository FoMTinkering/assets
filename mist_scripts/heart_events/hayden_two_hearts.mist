scene(haydens_house);
place_actor(hayden, south, h2h_hayden_entrance);
place_actor(henrietta, east, h2h_henrietta_entrance);
animate(henrietta, sleep);
place_actor(ryis, north, h2h_ryis_entrance);
place_actor(valen, north, h2h_valen_entrance);
place_actor(ari, north, h2h_ari_entrance);
camera_position(h2h_camera_1);
request_music_play(hayden);
setup_prop(h2h_veggie_platter);

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	pan_camera(4, h2h_camera_2);
	{
		walk_slow(ari, h2h_ari_start);
		face(ari, north);
	}
	{
		wait(0.5);
		free bark_speech(hayden, cold_drink);
		wait(0.5);
		free bark_speech(valen, hot_drink);
		wait(0.5);
		free bark_speech(ryis, yum);
	}
	{
		wait(2);
		free bark_speech(hayden, exclamation_mark);
	}
	{
		wait(2.5);
		face(valen, south);
	}
	{
		wait(3);
		face(ryis, south);
	}
	{
		wait(2.5);
		next_line(); //
		close_textbox();
		wait(0.5);
		free bark_speech(ari, cute_face);
		wait(0.5);
	}
}

next_line(); //
sim {
	{
		wait(1);
		face(valen, west);
		wait(1.5);
		face(valen, south);
	}
	{
		wait(1.5);
		face(ari, west);
		wait(1.5);
		face(ari, north);
	}
	{
		wait(0.5);
		face(ryis, west);
	}
	{
		next_line(); //
	}
}
sim {
	{
		wait(0.5);
		face(ryis, south);
	}
	{
		wait(1);
		face(ari, north);
	}
	{
		wait(1.25);
		face(valen, east);
	}
	{
		next_line(); //
		next_line(); //
	}
}
//
if get_response() == 0 {
	sim {
		{
			wait(0.5);
			free bark_speech(ryis, cute_face);
		}

		{
			next_line(); //
		}
	}
} else {
	sim {
		{
			wait(0.5);
			free bark_speech(ryis, sweat_drop);
		}
		{
			wait(1.75);
			face(ryis, north);
		}
		{
			wait(2.25);
			face(valen, north);
		}
		{
			next_line(); //
		}
	}
}
sim {
	{
		wait(0.5);
		face(ryis, north);
	}
	{
		wait(1);
		face(valen, north);
	}
	{
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(valen, cute_face);
free bark_speech(ryis, cute_face);
free bark_speech(ari, cute_face);
sim {
	{
		wait(1);
		walk_slow(valen, h2h_valen_start);
		face(valen, west);
		animate(valen, action);
		wait(1);
		animate(valen, idle);
		walk_slow(valen, "Couch Seat Left");
		animate(valen, sit);
		face(valen, north);
	}
	{
		wait(1.25);
		walk_slow(ryis, "Couch Seat Right");
		face(ryis, north);
		animate(ryis, drink);
	}
	{
		walk(hayden, h2h_hayden_start);
		face(hayden, north);
		animate(hayden, action);
	}
	{
		wait(1);
		animate(henrietta, idle);
	}
	{
		wait(2.25);
		walk_slow(ari, h2h_valen_start);
		face(ari, west);
		animate(ari, action);
		wait(1);
		animate(ari, idle);
		walk(ari, h2h_ari_watch);
		face(ari, north);
	}
	{
		wait(1);
		pan_camera(4, h2h_camera_3);
	}
	{
		wait(7);
		place_actor(march, north, h2h_ari_entrance);
		sim {
			walk(march, h2h_march_entrance);
			set_move_speed(march, 1);
		}
		face(march, north);
	}
}
sim {
	{
		wait(0.5);
		free bark_speech(hayden, exclamation_mark);
		animate(hayden, idle);
		wait(0.25);
		face(hayden, south);
	}
	{
		wait(1);
		face(ari, south);
	}
	{
		wait(0.5);
		pan_camera(1.25, h2h_camera_2);
	}
	{
		next_line(); //
	}
}
next_line(); //
close_textbox();

sim {
	{
		wait(0.5);
		face(hayden, north);
		animate(hayden, action);
	}
	{
		wait(1);
		face(ari, east);
	}
	pan_camera(3.5, h2h_camera_4);
	{
		walk(march, h2h_march_trigger);
		sim {
			{
				walk(march, h2h_march_stop);
				face(march, east);
				wait(0.25);
				free bark_speech(march, exclamation_mark);
				wait(0.25);
				animate(hayden, idle);
				animate(ryis, idle);
				free bark_speech(hayden, exclamation_mark);
				face(hayden, east);
			}
			{
				walk(henrietta, h2h_henrietta_hop);
				face(henrietta, south);
				animate(henrietta, jump);
				await_npc_animation(henrietta);
				place_actor(henrietta, south, h2h_henrietta_seat);
				animate(henrietta, idle);
				wait(0.25);
				face(henrietta, west);
			}
		}
	}
}
wait(1);
animate(march, idle);
next_line(); //
close_textbox();
wait(0.25);
sim {
	{
		animate(henrietta, crow);
		play_sound("SoundEffects/Animals/ChickenHenriettaCutscene");
		wait(0.5);
		animate(henrietta, flap);
		wait(0.5);
		animate(henrietta, idle);
	}
	{
		wait(0.25);
		animate(march, idle);
		place_actor(march, east, h2h_march_back);
		free bark_speech(march, exclamation_mark);
	}
	{
		wait(1);
		free bark_speech(hayden, sweat_drop);
	}
}
next_line(); //
sim {
	{
		wait(0.4);
		face(march, west);
	}
	{
		next_line(); //
		next_line(); //
	}
}
//

if get_response() == 0 {
	sim {
		{
			wait(0.5);
			free bark_speech(march, angry);
		}
		{
			next_line(); //
		}
	}
} else {
	sim {
		{
			wait(0.5);
			face(ari, north);
		}
		{
			wait(1.25);
			face(hayden, south);
		}
		{
			next_line(); //
		}
	}
}
close_textbox();

sim {
	free {
		wait(0.25);
		free bark(henrietta, annoyed);
		wait(0.5);
		face(henrietta, north);
		wait(0.25);
		animate(henrietta, jump);
		await_npc_animation(henrietta);
		place_actor(henrietta, north, h2h_henrietta_hop);
		animate(henrietta, idle);
		wait(0.25);
		walk(henrietta, h2h_ari_entrance);
		remove_actor(henrietta);
	}
	{
		wait(0.5);
		face(march, east);
		wait(2);
		face(march, south);
	}
	{
		wait(1);
		face(hayden, east);
		wait(2);
		face(hayden, south);
	}
	{
		wait(1.5);
		face(ari, east);
		wait(1.5);
		face(ari, south);
		wait(1);
		face(ari, east);
	}
	{
		wait(2);
		pan_camera(2, h2h_camera_3);
	}
	{
		wait(3.75);
		next_line(); //
		next_line(); //
	}
}
sim {
	{
		wait(0.5);
		face(march, west);
	}
	{
		next_line(); //
	}
}
close_textbox();
sim {
	{
		walk(hayden, h2h_march_trigger);
		face(hayden, south);
	}
	{
		wait(1);
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(ari, cute_face);
free bark_speech(valen, cute_face);
free bark_speech(ryis, cute_face);
free bark_speech(march, ellipses);
wait(1);
free bark_speech(hayden, cute_face);
wait(1);
fade_out(2);
