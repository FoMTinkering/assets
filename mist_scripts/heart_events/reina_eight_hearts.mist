	face(reina, south);
	wait(0.5);
	face(ari, south);
} else {
	checkpoint("kiss");
	sim {
		{
			wait(0.5);
			face(reina, west);
			wait(0.5);
			sim {
				walk(reina, r8h_reina_er_closer);
				set_move_speed(reina, 0.4);
			}
			face(reina, west);
		}
		{
			next_line(); //
		}
	}
	close_textbox();
	wait(0.5);
	var should_kiss = read_world_fact("shooting_star_reina_attended") == true and is_partner("reina");
	if should_kiss == true {
		kiss_npc(reina, false, 1);
	}
	free bark_speech(ari, heart);
	free bark_speech(reina, heart);
	wait(2);
	face(reina, south);
	wait(0.5);
	face(ari, south);
}
