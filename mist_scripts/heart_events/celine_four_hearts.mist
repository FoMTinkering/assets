fun watering_can() {
	animate(ari, water);
	ari_set_attachment(watering_can_worn);
	play_sound("SoundEffects/Tools/WateredSuccess");
	await_ari_animation();
	animate(ari, idle);
}

fun applying_fertilizer() {
	animate(ari, action);
	play_sound("SoundEffects/Tools/SeedUseSuccess");
	await_ari_animation();
	animate(ari, idle);
}

scene(celines_room);
camera_position(c4h_camera_1);
place_actor(ari, north, c4h_ari_entrance);
place_actor(celine, south, "ArmChair Seat");
animate(celine, book_sit);
request_music_play(celine);

sim {
	fade_in(2);
	{
		pan_camera(3, c4h_camera_2);
	}
