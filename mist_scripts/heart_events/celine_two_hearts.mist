animate(celine, idle);
face(celine, east);
next_line(); //
close_textbox();
sim {
	pan_camera(2, c2h_camera_6);
	{
		walk(celine, c2h_celine_reaction);
		face(celine, east);
		animate(celine, action);
		wait(0.5);
		animate(ari, idle);
		animate(celine, idle);
	}
	{
		wait(1);
		destroy_prop(c2h_unusual_seed);
		animate(ari, pickup);
		__ari_hold_item(unusual_seed);
		face(ari, west);
	}
	{
		wait(3);
		next_line(); //
		//
		next_line(); //
