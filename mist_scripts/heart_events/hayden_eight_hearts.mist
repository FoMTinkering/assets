var ari_keep_eating = false;
fun eat_loop() {
	if ari_keep_eating == false {
		return;
	}
	animate(ari, action);
	wait(0.5);
	animate(ari, sit);
	if ari_keep_eating == false {
		return;
	}
	wait(1);
	eat_loop();
}
