scene(town);
camera_position(a6h_camera_1_west);
place_actor(adeline, north, a6h_adeline_entrance);
request_music_play(adeline);

if get_position_x(ari) <= 1170 {
	place_actor(ari, east, a6h_ari_entrance_west);
	camera_position(a6h_camera_1_west);
} else {
	place_actor(ari, west, a6h_ari_entrance_east);
	camera_position(a6h_camera_1_east);
}

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		walk_slow(ari, a6h_ari_start);
		face(ari, north);
	}
	{
		pan_camera(4, a6h_camera_2);
	}
	{
		wait(1.5);
		face(adeline, south);
		animate(adeline, write);
		wait(1.25);
		free bark_speech(adeline, exclamation_mark);
		wait(0.5);
		animate(adeline, idle);
		walk(adeline, a6h_adeline_start);
		face(adeline, south);
	}
	{
		wait(4.5);
		next_line(); //
	}
}
sim {
	{
		wait(2.75);
		face(adeline, north);
		wait(1.25);
		face(adeline, south);
	}
	{
		next_line(); //
	}
}
sim {
	{
		wait(0.5);
		animate(adeline, think);
	}
	{
		next_line(); //
	}
}
sim {
	{
		wait(0.5);
		animate(adeline, finger_snap);
		wait(1.2);
		anim_speed(adeline, 0);
		wait(0.25);
		animate(adeline, idle);
		anim_speed(adeline, 1);
	}
	{
		wait(0.8);
		play_sound("SoundEffects/SpecialEvents/SnapAndDing");
	}
	{
		next_line(); //
	}
}
//
if get_response() == 0 {
	sim {
		{
			wait(0.75);
			free bark_speech(adeline, cute_face);
		}
		{
			next_line(); //
		}
	}
} else {
	next_line(); //
}
close_textbox();
wait(0.5);
free bark_speech(ari, cute_face);
wait(0.5);
free bark_speech(adeline, cute_face);
wait(1.5);
sim {
	{
		walk_slow(adeline, a6h_adeline_exit);
		face(adeline, west);
	}
	{
		wait(0.5);
		walk_slow(ari, a6h_ari_exit);
		face(ari, west);
	}
	{
		pan_camera(3, a6h_camera_1_west);
	}
	{
		wait(1);
		fade_out(2);
	}
}

wait(1);

