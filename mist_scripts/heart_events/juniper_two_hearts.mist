		animate(olric, idle);
		wait(1);
	}

}

//
var season = current_season();
if season == "spring" {
	set_outfit(olric, spring_bunny_ears);
	walk(olric, j2h_olric_start);
} else if season == "summer" {
	set_outfit(olric, summer_bunny_ears);
	walk(olric, j2h_olric_start);
} else if season == "fall" {
	set_outfit(olric, autumn_bunny_ears);
	walk(olric, j2h_olric_start);
} else if season == "winter" {
	set_outfit(olric, winter_bunny_ears);
	walk(olric, j2h_olric_start);
}

