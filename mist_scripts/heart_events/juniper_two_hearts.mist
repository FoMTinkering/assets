place_actor(juniper, west, j2h_juniper_start);
place_actor(olric, east, j2h_olric_start);
request_music_play(juniper);

sim {
	fade_in(2);
	{
		walk_slow(ari, j2h_ari_pause);
		face(ari, east);
		wait(3);
		sim {
			walk(ari, j2h_ari_forward);
			set_move_speed(ari, 0.25);
		}
		face(ari, east);
	}
	{
		wait(1.5);
		free bark(ari, exclamation_mark);
	}
	{
		wait(1);
		pan_camera(3, j2h_camera_2);
	}
	{
		wait(1);
		next_line(); //
		next_line(); //
		next_line(); //
	}
}
