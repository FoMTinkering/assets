scene(caldarus_house);
var ari_start = __get_element_x(ari);
if ari_start >= 265 {
	place_actor(ari, west, c8h_ari_entrance_teleport);
	camera_position(c8h_camera_1_teleport);
} else {
	place_actor(ari, north, c8h_ari_entrance_door);
	camera_position(c8h_camera_1_door);
}
place_actor(caldarus, east, c8h_caldarus_entrance);
animate(caldarus, action);
request_music_play("Music/Location Tracks/Deep Woods");

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		if ari_start >= 265 {
			pan_camera(3, c8h_camera_2_teleport);
		} else {
			pan_camera(3, c8h_camera_2_door);
		}
	}
	{
		wait(0.5);
		anim_speed(caldarus, 0);
		wait(1);
		free bark_speech(caldarus, exclamation_mark);
		wait(0.5);
		anim_speed(caldarus, 1);
		animate(caldarus, idle);
		if ari_start >= 265 {
			face(caldarus, east);
		} else {
			face(caldarus, south);
		}
	}
	{
		if ari_start <= 265 {
			walk_slow(ari, c8h_ari_start);
			face(ari, north);
		}
	}
	{
		wait(2.5);
		next_line(); //
		next_line(); //
	}
}

if ari_start >= 265 {
	next_line(); //
} else {
	sim {
		{
			wait(1);
			face(caldarus, east);
			wait(1.25);
			face(caldarus, south);
		}
		{
			next_line(); //
		}
	}
}
