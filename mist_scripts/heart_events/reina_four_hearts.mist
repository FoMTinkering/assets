scene(general_store_store);
camera_position(r4h_camera_1);
place_actor(ari, north, r4h_ari_entrance);
place_actor(reina, north, r4h_reina_entrance);
place_actor(holt, south, r4h_holt_entrance);
chat(reina, holt);
request_music_play(reina);

sim {
	fade_in(2);
	pan_camera(4, r4h_camera_2);
	{
		walk_slow(ari, r4h_ari_start);
		face(ari, east);
	}
	{
		wait(1);
		stop_chat(reina);
		stop_chat(holt);
		free bark_speech(reina, exclamation_mark);
		wait(0.5);
		walk(reina, r4h_reina_start);
		face(reina, west);
	}
	{
		wait(2.25);
		walk_slow(holt, "General Store Register");
		face(holt, south);
	}
	{
		wait(2);
		next_line(); //
	}
}
close_textbox();
free bark_speech(ari, music);
wait(0.5);
free bark_speech(reina, cute_face);
wait(0.5);

sim {
	{
		wait(0.5);
		face(reina, north);
		wait(0.25);
		face(ari, north);
	}
	{
		next_line(); //
		next_line(); //
	}
}

sim {
	{
		wait(0.5);
		face(reina, west);
		wait(0.25);
		face(ari, east);
	}
	{
		next_line(); //
		//
		next_line(); //
	}
}
sim {
	{
		wait(0.5);
		face(reina, south);
	}
	{
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(reina, ellipses);
face(reina, east);
wait(1);
sim {
	pan_camera(3, r4h_camera_3);
	{
		walk_slow(reina, r4h_reina_examine);
		face(reina, east);
		wait(0.5);
		animate(reina, action);
		wait(0.5);
		animate(reina, idle);
		wait(0.5);
		face(reina, west);
		wait(0.5);
		free bark_speech(reina, exclamation_mark);
	}
	{
		wait(0.75);
		face(ari, south);
		wait(0.75);
		face(ari, west);
		wait(0.5);
		walk_slow(ari, r4h_ari_searching);
		face(ari, west);
		wait(0.5);
		animate(ari, action);
		wait(0.5);
		animate(ari, idle);
	}
}
sim {
	pan_camera(3, r4h_camera_4);
	{
		wait(0.25);
		walk(reina, r4h_reina_thyme);
		face(reina, south);
	}
	{
		wait(1);
		face(ari, south);
		wait(0.5);
		walk_slow(ari, r4h_ari_thyme);
		face(ari, south);
	}
	{
		wait(0.5);
		next_line(); //
	}
}
close_textbox();
wait(1);
walk_slow(ari, r4h_ari_smell);
face(ari, south);
wait(0.5);
animate(ari, blink);
wait(0.2);
freeze_ari();
wait(1);
free bark_speech(ari, cute_face);
wait(0.5);
animate(ari, idle);
walk_slow(reina, r4h_reina_smell);
face(reina, east);
wait(0.5);
free bark_speech(reina, cute_face);
wait(0.5);
sim {
	{
		wait(0.5);
		face(ari, west);
	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(1);
free bark_speech(ari, sweat_drop);
free bark_speech(reina, sweat_drop);
wait(1.5);

sim {
	sim {
		wait(1);
		pan_camera(5, r4h_camera_5);
	}
	{
		wait(1);
		walk_slow(holt, r4h_holt_retrieval);
		face(holt, east);
		wait(0.25);
		animate(holt, action);
		wait(0.5);
		animate(holt, idle);
		walk_slow(holt, r4h_holt_entrance);
		face(holt, east);
	}
	{
		wait(0.5);
		face(reina, north);
		wait(0.75);
		walk(reina, r4h_reina_entrance);
		face(reina, west);
	}
	{
		wait(1);
		face(ari, north);
		wait(1.5);
		walk(ari, r4h_ari_mushroom);
		face(ari, west);
	}
	{
		next_line(); //
	}
}
sim {
	{
		animate(holt, action);
		wait(0.5);
		setup_prop(r4h_store_mushroom);
		animate(holt, idle);
	}
	{
		next_line(); //
		next_line(); //
		next_line(); //
		next_line(); //
		next_line(); //
	}
}

//

if get_response() == 0 {
	sim {
		{
			wait(0.5);
			face(reina, east);
		}
		{
			next_line(); //
		}
	}
} else {
	next_line(); //
	close_textbox();
	free bark_speech(reina, sweat_drop);
	wait(1);
}
sim {
	{
		wait(0.5);
		face(reina, west);
	}
	{
		next_line(); //
	}
}
sim {
	{
		wait(1.25);
		face(reina, east);
	}
	{
		next_line(); //
	}
}
close_textbox();
free bark_speech(holt, cute_face);
wait(0.5);
face(reina, west);
free bark_speech(reina, cute_face);
free bark_speech(ari, cute_face);
wait(0.5);
animate(reina, action);
wait(0.5);
destroy_prop(r4h_store_mushroom);
animate(reina, idle);
sim {
	fade_out(2);
	free pan_camera(6, r4h_camera_1);
	{
		free walk_slow(reina, r4h_ari_entrance);
		wait(1);
		walk_slow(ari, r4h_reina_examine); //
	}
}
remove_actor(reina);
wait(1);
//
scene(reinas_room);
place_actor(ari, north, r4h_ari_entrance_room);
place_actor(reina, north, r4h_reina_entrance_room);
camera_position(r4h_camera_6);

sim {
	pan_camera(4, r4h_camera_7);
	{
		wait(0.25);
		fade_in(2);
	}
	{
		walk_slow(reina, r4h_reina_cutting_board);
		face(reina, south);
		wait(0.5);
		animate(reina, action);
		wait(0.5);
		setup_prop(r4h_room_mushroom);
		animate(reina, idle);
		walk_slow(reina, r4h_reina_side_step);
	}
	{
		wait(1);
		walk_slow(ari, r4h_ari_start_room);
		face(ari, west);
	}
	{
		wait(3);
		next_line(); //
	}
}

//

sim {
	{
		wait(0.5);
		face(reina, east);
	}
	{
		next_line(); //
	}
}
close_textbox();
walk_slow(reina,r4h_reina_cutting_board);
wait(0.5);
face(reina, south);
wait(0.5);
animate(reina, action);
wait(0.5);
sim {
	{
		play_sound("SoundEffects/UI/UIIncorrectMild");
	}
	{
		destroy_prop(r4h_room_mushroom);
		animate(reina, idle);
	}
}
wait(0.5);
walk(reina, r4h_reina_stove);
face(reina, north);
wait(0.25);
sim {
	{
		animate(reina, action);
		wait(0.5);
		animate(reina, idle);
	}
	{
		play_sound("SoundEffects/SpecialEvents/ReinaCookingSequence");
	}
}

walk(reina, r4h_reina_cutting_board);
face(reina, south);
animate(reina, action);
wait(0.5);
animate(reina, idle);
walk(reina, r4h_reina_stove);
face(reina, north);
sim {
	{
		animate(reina, action);
		wait(0.5);
		animate(reina, idle);
	}
	{
		//
	}
}
wait(0.5);
sim {
	{
		animate(reina, action);
		wait(1);
		free bark_speech(reina, exclamation_mark);
		animate(reina, idle);
	}
	{
		//
	}
}
sim {
	{
		wait(0.5);
		animate(reina, action);
		wait(0.5);
		animate(reina, idle);
		walk(reina, r4h_reina_cutting_board);
		animate(reina, action);
		wait(0.5);
		sim{
			{
				play_sound("SoundEffects/SpecialEvents/RevealTransition");
			}
			{
				setup_prop(r4h_finished_dish);
			}
		}

		animate(reina, idle);
		wait(0.5);
		walk(reina, r4h_reina_side_step);
		face(reina, east);
	}
	{
		wait(2);
		next_line(); //
	}
}
close_textbox();
sim {
	{
		wait(0.5);
		face(reina, south);
		wait(0.25);
		animate(reina, action);
		wait(0.5);
		animate(reina, idle);
	}
	{
		wait(0.75);
		walk_slow(ari, r4h_ari_side_step);
		face(ari, south);
		animate(ari, action);
		wait(0.5);
		destroy_prop(r4h_finished_dish);
		use_item(dragon_horn_mushroom_with_thyme);
		animate(ari, idle);
	}
}
free bark_speech(ari, heart);
wait(1);
next_line(); //
close_textbox();
wait(2.5);
free bark_speech(ari, hungry);
wait(1);
free bark_speech(reina, exclamation_mark);
wait(0.5);
face(reina, east);
wait(0.5);
sim {
	{
		wait(1.5);
		face(reina, south);
	}
	{
		wait(0.5);
		face(ari, west);
	}
	{
		next_line(); //
	}
}
sim {
	{
		wait(0.5);
		face(reina, east);
	}
	{
		next_line(); //
	}
}
close_textbox();
free bark_speech(ari, cute_face);
wait(0.5);
free bark_speech(reina, cute_face);
wait(1);
sim {
	fade_out(2);
	free pan_camera(4, r4h_camera_6);
	{
		walk_slow(ari, r4h_ari_entrance_room);
		face(ari, south);
	}
	{
		wait(0.75);
		walk_slow(reina, r4h_reina_entrance_room);
		face(reina, south);
