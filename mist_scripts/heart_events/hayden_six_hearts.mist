		walk_slow(ari, h6h_henrietta_bin);
		face(ari, north);
		animate(ari, action);
		wait(0.5);
		destroy_prop(h6h_shop_corn_bin);
		animate(ari, idle);
		walk(ari, h6h_ari_counter);
		face(ari, east);
		animate(ari, action);
		wait(0.5);
		setup_prop(h6h_shop_corn_counter);
		animate(ari, idle);
	}
	{
		wait(2);
		pan_camera(4, h6h_camera_6);
