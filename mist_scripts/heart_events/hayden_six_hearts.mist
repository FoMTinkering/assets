	}
	{
		wait(0.25);
		pan_camera(3, h6h_camera_3);
		wait(1.5);
		pan_camera(3, h6h_camera_4);
		wait(1.5);
		pan_camera(2, h6h_camera_5);
	}
	{
		wait(7.5);
		walk_slow(ari, h6h_ari_bin);
		face(ari, west);
	}
	{
		wait(2);
		face(holt, west);
	}
}
