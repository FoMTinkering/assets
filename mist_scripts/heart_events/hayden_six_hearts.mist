scene(general_store_store);
camera_position(h6h_camera_1);
place_actor(ari, north, h6h_ari_entrance);
place_actor(hayden, north, h6h_hayden_entrance);
place_actor(henrietta, north, h6h_henrietta_entrance);
place_actor(holt, south, h6h_holt_entrance);
setup_prop(h6h_shop_corn_bin);
setup_prop(h6h_shop_corn_bin_extra);
setup_prop(h6h_shop_corn_bin_another);
setup_prop(h6h_shop_corn_filler_1);
setup_prop(h6h_shop_corn_filler_2);
request_music_play(hayden);

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		walk_slow(ari, h6h_ari_start);
		face(ari, north);
	}
	{
		wait(1);
		free bark_speech(hayden, exclamation_mark);
		wait(0.5);
		face(hayden, south);
	}
	{
		wait(2);
		face(henrietta, south);
	}
	{
		wait(1.75);
		next_line(); //
	}
	{
		pan_camera(3, h6h_camera_2);
	}
}
sim {
	{
		wait(3);
		face(hayden, west);
	}
	{
		wait(3.5);
		face(henrietta, east);
	}
	{
		next_line(); //
	}
}
sim {
	{
		wait(0.5);
		face(hayden, north);
	}
	{
		wait(1);
		face(henrietta, north);
	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark(henrietta, music);
play_sound("SoundEffects/Animals/ChickenHenriettaCutscene");
wait(1.5);
free bark_speech(holt, cute_face);
wait(1);
sim {
	{
		wait(0.5);
		face(hayden, west);
	}
	{
		wait(1);
		face(henrietta, east);
	}
	{
		next_line(); //
	}
}

