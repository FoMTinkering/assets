free bark_speech(hayden, cute_face);
wait(1);
sim {
	free {
		walk_slow(henrietta, h6h_ari_entrance);
		remove_actor(henrietta);
	}
	free {
		wait(1);
		walk_slow(hayden, h6h_henrietta_counter);
		face(hayden, west);
		animate(hayden, action);
		wait(0.5);
		destroy_prop(h6h_shop_strawberry);
		animate(hayden, idle);
		walk_slow(hayden, h6h_ari_entrance);
		remove_actor(hayden);
	}
	{
		wait(2);
		pan_camera(3, h6h_camera_2);
	}
	{
		wait(2);
		face(holt, south);
		wait(1.5);
		face(holt, north);
		wait(3);
		walk_slow(holt, h6h_holt_entrance);
		face(holt, south);
	}
	{
		wait(2.5);
		face(ari, south);
		wait(1.5);
		free bark_speech(ari, cute_face);
		wait(1.5);
		walk_slow(ari, h6h_ari_exit);
		face(ari, south);
	}
	{
		wait(7);
		fade_out(2);
	}
}

