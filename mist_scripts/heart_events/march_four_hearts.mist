fun ari_hammer() {
	face(ari, west);
	play_sound("SoundEffects/Tools/BlacksmithingHammerSwingAndHit");
	face(ari, west);
	animate(ari, axe);
	ari_set_attachment(craftinghammer);
	face(ari, west);
	await_ari_animation();
	animate(ari, idle);
	wait(0.25);
}
scene(town);
camera_position(m4h_camera_1);
place_actor(ari, west, m4h_ari_entrance);
place_actor(olric, north, m4h_march_forge);
request_music_play("Music/Events/Cutscene");

sim {
	fade_in(2);
	{
		walk_slow(ari, m4h_ari_pause);
		face(ari, west);
		wait_one_tick();
		walk_slow(ari, m4h_ari_start);
		face(ari, west);
	}
	{
		wait(3);
		free bark_speech(olric, exclamation_mark);
		wait(0.5);
		animate(olric, idle);
		wait(0.5);
		face(olric, east);
		wait(0.5);
		walk(olric, m4h_olric_start);
		face(olric, east);
	}
	{
		wait(5.5);
		next_line(); //
		next_line(); //
		//
		next_line(); //
		next_line(); //
	}
	{
		pan_camera(6, m4h_camera_3);
	}
}

