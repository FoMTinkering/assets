animate(ari, spellcast_loop);
place_actor(juniper, west, j6h_ari_entrance);
place_actor(dozy, west, j6h_dozy_entrance);
animate(dozy, doze_1);

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
