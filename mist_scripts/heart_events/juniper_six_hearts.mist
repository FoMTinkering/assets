wait(0.5);
free bark_speech(juniper, cute_face);
wait(0.5);
walk_slow(juniper, j6h_juniper_cr_forward);
face(juniper, west);
animate(juniper, action);
wait(0.5);
animate(juniper, idle);
sim {
	{
		walk_slow(juniper, j6h_juniper_cr_start);
		face(juniper, west);
	}
	{
		wait(0.5);
		free bark_speech(celine, cute_face);
	}
	{
		wait(1);
		next_line(); //

	}
}
close_textbox();
sim {
	{
		walk_slow(celine, j6h_celine_start);
		face(celine, north);
		animate(celine, action);
		wait(0.5);
		setup_prop(j6h_tonic);
		animate(celine, idle);
	}
	{
		wait(1);
		walk_slow(juniper, j6h_juniper_cr_north);
		face(juniper, north);
	}
	{
		pan_camera(2.5, j6h_camera_7);
	}
}
wait(0.5);
free bark_speech(celine, ellipses);
wait(1.5);
next_line(); //
sim {
	{
		wait(0.5);
		walk_slow(celine, j6h_celine_forward);
		face(celine, south);
	}
	{
		pan_camera(2, j6h_camera_8);
	}
	{
		next_line(); //
		next_line(); //
	}
}
//
if get_response() == 0 {
	sim {
		{
			wait(0.75);
			free bark_speech(celine, cute_face);
		}
		{
			next_line(); //
		}
	}
} else {
	sim {
		//
		//
		//
		//
		{
			next_line(); //
		}
	}
}
