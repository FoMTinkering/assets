	{
		pan_camera(2, j6h_camera_7);
	}
	{
		walk_slow(celine, "Desk Seat");
		face(celine, north);
		animate(celine, sit);
		wait(0.75);
		face(celine, south);
	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(celine, cute_face);
wait(1);
sim {
	{
		face(celine, north);
	}
	{
		wait(0.5);
		walk_slow(juniper, j6h_juniper_cr_entrance);
		remove_actor(juniper);
	}
	{
		pan_camera(3, j6h_camera_5);
	}
	{
		wait(1);
		fade_out(2);
	}
}

