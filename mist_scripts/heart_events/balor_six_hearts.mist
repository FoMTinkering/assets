}
//
if get_response() == 1 {
	sim {
		{
			wait(0.75);
			face(hemlock, south);
			wait(1);
			face(balor, west);
			wait(0.5);
			face(hemlock, east);
		}
		{
			next_line(); //
			close_textbox();
		}
	}
	face(balor, south);
} else {
	next_line();
	close_textbox();
}
if get_response() == 1 {
	lemonade = true;
	sim {
		{
			wait(0.5);
			walk_slow(hemlock, b6h_hemlock_lemonade_grab);
			face(hemlock, east);
