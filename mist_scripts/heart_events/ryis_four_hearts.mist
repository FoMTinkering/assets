}
close_textbox();
sim {
	{
		place_actor(balor, north, r4h_ari_entrance);
		walk(balor, r4h_ari_start);
		face(balor, west);
	}
	{
		wait(1);
		pan_camera(1.5, r4h_camera_3);
		pan_camera(2, r4h_camera_4);
	}
	{
		wait(1);
		free bark_speech(ryis, exclamation_mark);
		free bark_speech(ari, exclamation_mark);
	}
	{
		wait(1.5);
		face(ari, north);
		wait(1);
		walk(ari, r4h_ari_back);
		face(ari, north);
	}
	{
		wait(0.5);
		next_line(); //
	}
}
sim {
	{
		wait(0.5);
		walk(balor, r4h_balor_forward);
		face(balor, west);
		animate(balor, action);
		wait(0.5);
		animate(balor, idle);
		wait(0.25);
		walk(balor, r4h_ari_start);
		face(balor, west);
	}
	{
		next_line(); //
		next_line(); //
	}
}
