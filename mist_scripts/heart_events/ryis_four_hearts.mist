wait(0.5);
sim {
	free {
		walk(balor, r4h_ari_entrance);
		face(balor, south);
		remove_actor(balor);
	}
	{
		wait(1);
		walk_slow(ari, r4h_ari_start);
		face(ari, west);
	}
	{
		wait(2);
		next_line(); //
	}
	pan_camera(2, r4h_camera_2);
}
close_textbox();
wait(0.5);
free bark_speech(ari, cute_face);
wait(1);
sim {
	free {
		walk_slow(ari, r4h_ari_exit);
		face(ari, south);
	}
	{
		wait(1);
		walk_slow(ryis, r4h_ryis_exit);
		face(ryis, south);
	}
	{
		wait(0.25);
		fade_out(2);
	}
	free pan_camera(4, r4h_camera_1);
}
//
wait(1);

scene(eastern_road);
camera_position(r4h_camera_5);
place_actor(ari, north, r4h_ari_er_entrance);
place_actor(ryis, east, r4h_ryis_er_entrance);
animate(ryis, saw);
ryis_is_sawing = true;

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		pan_camera(6, r4h_camera_6);
	}
	{
		ryis_saw_sound();
		ryis_saw_sound();
		ryis_saw_sound();
		ryis_saw_sound();
		ryis_saw_sound();
		ryis_saw_sound();
		ryis_saw_sound();
		ryis_saw_sound();
		ryis_saw_sound();
		ryis_saw_sound();
	}
	{
		wait(3);
		//
		sim {
			override_requirement("ryis_stump_removed");
			set_on_blackboard("refresh_tree_sprite", true);
			create_animation(spr_fx_poof1_dirt_once, r4h_poof, 0, 0, 0, -5000);
		}

		animate(ryis, idle);
		ryis_is_sawing = false;
		wait(0.5);
		walk(ryis, r4h_ryis_er_start);
		face(ryis, north);
	}
	{
		wait(3.75);
		walk(ari, r4h_ari_er_start);
		face(ari, north);
		animate(ari, action);
		wait(1);
		animate(ari, idle);
		//
		sim {
			override_requirement("ryis_tree_planted");
			set_on_blackboard("refresh_tree_sprite", true);
			create_animation(spr_fx_poof1_dirt_once, r4h_poof, 0, 0, 0, -10);
		}
		wait(0.5);
		walk(ari, r4h_ari_er_entrance);
		face(ari, north);
	}
}
sim {
	{
		wait(0.5);
		face(ryis, east);
	}
	{
		wait(1);
		face(ari, west);
	}
	{
		next_line(); //
		next_line(); //
	}
}
//
if get_response() == 0 {
	next_line(); //
} else {
	sim {
		{
			wait(1);
			face(ryis, north);
		}
		{
			wait(1);
			pan_camera(1.5, r4h_camera_7);
		}
		{
			next_line(); //
