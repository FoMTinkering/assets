var ryis_is_sawing = false;

fun ryis_saw_sound() {
	if ryis_is_sawing == false {
		wait(0.5);
		return;
	}
	play_sound("SoundEffects/Tools/SawBackAndForth2D");
	wait(0.45);
}

scene(landens_house_f2);
camera_position(r4h_camera_1);
place_actor(ari, north, r4h_ari_entrance);
place_actor(ryis, west, r4h_ryis_entrance);
animate(ryis, sit);
camera_position(r4h_camera_1);
request_music_play(ryis);

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		walk(ari, r4h_ari_start);
		face(ari, west);
	}
	{
		wait(3.5);
		free bark_speech(ryis, exclamation_mark);
		wait(0.5);
		face(ryis, east);
	}
	{
		wait(4.5);
		next_line(); //
	}
	pan_camera(4.5, r4h_camera_2);
}
sim {
	{
		wait(1.5);
		face(ryis, south);
	}
	{
		next_line(); //
	}
}

