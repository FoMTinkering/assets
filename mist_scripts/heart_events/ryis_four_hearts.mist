	}
	close_textbox();
	wait(1);
	bark_speech(ryis, ellipses);
	sim {
		{
			wait(0.25);
			face(ryis, east);
			wait(0.25);
		}
		pan_camera(1.5, r4h_camera_6);
		{
			next_line(); //
		}
	}
}
next_line(); //
close_textbox();
free bark_speech(ari, cute_face);
