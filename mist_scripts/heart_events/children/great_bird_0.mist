fade_npc_alpha(ari, 0.0, 1.0, 150);
camera_position(gb0_camera_1);
request_music_play("Music/Events/Twinkling Light"); //
fade_in(2.5);
sim {
    {
        pan_camera(4, gb0_camera_2);
    }
    {
        wait(1);
        setup_prop(gb_bird);
        fade_prop_alpha(gb_bird, 0.0, 1.0, 180);
        setup_prop(gb0_star_bkg);
        fade_prop_alpha(gb0_star_bkg, 0.0, 1.0, 180);
    }
    {
        wait(2.5);
        free bark_speech(ari, exclamation_mark);
    }
}
next_line(); //
