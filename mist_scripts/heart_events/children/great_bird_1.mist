create_black_overlay();
place_actor(ari, north, gb1_ari_entrance);
raise_actor(ari);
fade_npc_alpha(ari, 0.0, 1.0, 150);
place_actor(spouse, north, gb1_spouse_entrance);
raise_actor(spouse);
fade_npc_alpha(spouse, 0.0, 1.0, 150);
camera_position(gb1_camera_1);
request_music_play("Music/Events/Twinkling Light"); //
fade_in(2.5);
sim {
    {
        pan_camera(4, gb1_camera_2);
    }
    {
        wait(0.5);
        setup_prop(gb_bird);
        fade_prop_alpha(gb_bird, 0.0, 1.0, 180);
        setup_prop(gb1_star_bkg);
        fade_prop_alpha(gb1_star_bkg, 0.0, 1.0, 180);
    }
    {
        wait(2.5);
        free bark_speech(spouse, exclamation_mark);
    }
