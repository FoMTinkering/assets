                face(ari, north);
            }
        }
        next_line(); //
        next_line(); //
        next_line(); //
        close_textbox();
        free bark_speech(ari, cute_face);
        wait(2);
        free pan_camera(2, gb1_camera_5);
        wait(0.5);
        face(ari, west);
        wait(0.5);
        face(spouse, east);
        wait(0.5);
        next_line(); //
        next_line(); //
        //
    } else {
        close_textbox();
        sim {
            {
                wait(0.75);
                free bark_speech(spouse, exclamation_mark);
            }
            {
                wait(1.5);
                next_line(); //
            }
        }

        //
        //
        if get_response() == 0 {
            next_line(); //
            close_textbox();
            sim {
                {
                    wait(0.5);
                    face(spouse, north);
                }
                {
                    wait(1);
                    face(ari, north);
                }
                {
                    pan_camera(3, gb1_camera_3);
                }
                {
                    wait(3);
                    next_line(); //
                }
            }
            next_line(); //
            close_textbox();
            wait(0.5);
            free bark_speech(ari, cute_face);
            free bark_speech(spouse, cute_face);
            wait(2);
            next_line(); //
            next_line(); //
            close_textbox();
            free pan_camera(3, gb1_camera_5);
            wait(1.5);
            face(ari, west);
            wait(0.75);
            face(spouse, east);
            wait(0.75);
            next_line(); //
            next_line(); //
            //
        } else if get_response() == 1 {
            close_textbox();
            sim {
                {
                    wait(0.75);
                    free bark_speech(spouse, exclamation_mark);
                }
                {
                    wait(1.5);
                    next_line(); //
                    next_line(); //
                    next_line(); //
                }
            }
            close_textbox();
            wait(0.5);
            free bark_speech(spouse, heart);
            wait(1);
            free bark_speech(ari, heart);
            wait(1.5);
            free pan_camera(3, gb1_camera_2);
            wait(1.5);
            face(spouse, north);
            wait(0.5);
            face(ari, north);
            wait(1);
            next_line(); //
            next_line(); //
            next_line(); //
            next_line(); //
            next_line(); //
            close_textbox();
            wait(0.5);
            free bark_speech(spouse, cute_face);
            wait(2);
            free pan_camera(2, gb1_camera_5);
            wait(1);
            face(ari, west);
            wait(0.5);
            face(spouse, east);
            wait(0.5);
            next_line(); //
            next_line(); //
            close_textbox();
            free bark_speech(ari, cute_face);
            free bark_speech(spouse, cute_face);
            wait(2);
            //
        } else {
            next_line(); //
            close_textbox();
            wait(0.5);
            free bark_speech(ari, cute_face);
            wait(1);
            free bark_speech(spouse, cute_face);
            wait(2);
            next_line(); //
            close_textbox();
            wait(0.5);
            free bark_speech(ari, heart);
            free bark_speech(spouse, heart);
            wait(1.5);
            sim {
                {
                    pan_camera(3, gb1_camera_2);
                }
                {
                    wait(0.5);
                    face(spouse, north);
                }
                {
                    wait(1);
                    face(ari, north);
                }
            }
            next_line(); //
            next_line(); //
            next_line(); //
            close_textbox();
            free bark_speech(ari, cute_face);
            wait(2);
            free pan_camera(2, gb1_camera_5);
            wait(1);
            face(ari, west);
            wait(0.5);
            face(spouse, east);
            wait(0.5);
            next_line(); //
            next_line(); //
            //
        }
    }
    //
    close_textbox();
    wait(0.5);
	kiss_npc(spouse);
    wait(1);
    fade_out(3);

}
