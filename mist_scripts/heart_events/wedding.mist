//
fun wedding_setup() {

    //
    setup_prop(ari_candle_unlit);
    setup_prop(spouse_candle_unlit);
    setup_prop(central_candle_unlit);

    //
    //
    place_actor(ari, north, ari_wed_entrance);
    set_ari_to_idle(); //
    //
    apply_wedding_outfit();

    set_outfit(spouse, wedding);
    place_actor(spouse, north, spouse_wed_entrance);
    //


    //
    place_actor(ari_party_0, south, ari_party_0_wedding_place);
    place_actor(ari_party_1, south, ari_party_1_wedding_place);

    //
    place_actor(spouse_party_0, south, spouse_party_0_wedding_place);
    place_actor(spouse_party_1, south, spouse_party_1_wedding_place);

    //
    place_actor(elsie, south, elsie_wedding_place);

    //

    //
    //
    //
    //
    //
    //

    //
    place_actor(priority_0, north, priority_0_seat);
    animate(priority_0, sit);
    place_actor(priority_1, north, priority_1_seat);
    animate(priority_1, sit);
    place_actor(priority_2, north, priority_2_seat);
    animate(priority_2, sit);
    place_actor(priority_3, north, priority_3_seat);
    animate(priority_3, sit);
    place_actor(priority_4, north, priority_4_seat);
    animate(priority_4, sit);
    place_actor(priority_5, north, priority_5_seat);
    animate(priority_5, sit);
    place_actor(priority_6, north, priority_6_seat);
    animate(priority_6, sit);
    place_actor(priority_7, north, priority_7_seat);
    animate(priority_7, sit);

    //
    //
    //
    place_actor(standard_0, north, standard_0_seat);
    animate(standard_0, sit);
    place_actor(standard_1, north, standard_1_seat);
    animate(standard_1, sit);
    place_actor(standard_2, north, standard_2_seat);
    animate(standard_2, sit);
    place_actor(standard_3, north, standard_3_seat);
    animate(standard_3, sit);
    place_actor(standard_4, north, standard_4_seat);
    animate(standard_4, sit);
    place_actor(standard_5, north, standard_5_seat);
    animate(standard_5, sit);
    place_actor(standard_6, north, standard_6_seat);
    animate(standard_6, sit);
    place_actor(standard_7, north, standard_7_seat);
    animate(standard_7, sit);
    if is_defined(standard_8) {
        place_actor(standard_8, north, standard_8_seat);
        animate(standard_8, sit);
    }
    if is_defined(standard_9) {
        place_actor(standard_9, north, standard_9_seat);
        animate(standard_9, sit);
    }

    //

    if is_defined(extra_0) {
        place_actor(extra_0, north, extra_0_seat);
        animate(extra_0, sit);
    }

    if is_defined(extra_1) {
        place_actor(extra_1, north, extra_1_seat);
        animate(extra_1, sit);
    }

    //
    if spouse != "hayden" {
        place_actor(henrietta, north, henrietta_wedding_place);
    }
    if spouse != "juniper" {
        place_actor(dozy, north, dozy_wedding_place);
    }


}

fun wedding_cheer() {
    free bark_speech(elsie, cute_face);

    free bark_speech(ari_party_0, cute_face);
    free bark_speech(ari_party_1, cute_face);

    free bark_speech(spouse_party_0, cute_face);
    if spouse_party_1 == "dozy" or spouse_party_1 == "henrietta" {
        free bark(spouse_party_1, cute_face);
    } else {
        free bark_speech(spouse_party_1, cute_face);
    }

    free bark_speech(priority_0, cute_face);
    free bark_speech(priority_1, cute_face);
    free bark_speech(priority_2, cute_face);
    free bark_speech(priority_3, cute_face);
    free bark_speech(priority_4, cute_face);
    free bark_speech(priority_5, cute_face);
    free bark_speech(priority_6, cute_face);
    free bark_speech(priority_7, cute_face);

    free bark_speech(standard_0, cute_face);
    free bark_speech(standard_1, cute_face);
    free bark_speech(standard_2, cute_face);
    free bark_speech(standard_3, cute_face);
    free bark_speech(standard_4, cute_face);
    free bark_speech(standard_5, cute_face);
    free bark_speech(standard_6, cute_face);
    free bark_speech(standard_7, cute_face);
    if is_defined(standard_8) {
        free bark_speech(standard_8, cute_face);
    }
    if is_defined(standard_9) {
        free bark_speech(standard_9, cute_face);
    }

    if is_defined(extra_0) {
        free bark_speech(extra_0, cute_face);
    }

    if is_defined(extra_1) {
        free bark_speech(extra_1, cute_face);
    }

    if spouse_party_1 != "dozy" {
        free bark(dozy, cute_face);
    }

    if spouse_party_1 != "henrietta" {
        free bark(henrietta, cute_face);
    }

}
fun wedding_party_cheer() {
    free bark_speech(elsie, cute_face);

    free bark_speech(ari_party_0, cute_face);
    free bark_speech(ari_party_1, cute_face);

    free bark_speech(spouse_party_0, cute_face);
    if spouse_party_1 == "dozy" or spouse_party_1 == "henrietta" {
        free bark(spouse_party_1, cute_face);
    } else {
        free bark_speech(spouse_party_1, cute_face);
    }
}
fun wedding_guests_cheer() {

    free bark_speech(priority_0, cute_face);
    wait(0.1);
    free bark_speech(standard_2, cute_face);
    wait(0.1);
    free bark_speech(priority_7, cute_face);
    if is_defined(standard_9) {
        free bark_speech(standard_9, cute_face);
    }
    wait(0.1);
    free bark_speech(priority_2, cute_face);
    free bark_speech(standard_0, cute_face);
    wait(0.1);
    free bark_speech(standard_6, cute_face);
    wait(0.1);
    free bark_speech(priority_1, cute_face);
    wait(0.1);
    free bark_speech(standard_5, cute_face);
    wait(0.1);
    free bark_speech(priority_4, cute_face);
    free bark_speech(standard_4, cute_face);
    wait(0.1);
    free bark_speech(priority_3, cute_face);
    wait(0.1);
    free bark_speech(priority_6, cute_face);
    free bark_speech(standard_1, cute_face);
    wait(0.1);
    free bark_speech(standard_7, cute_face);
    wait(0.1);
    free bark_speech(priority_5, cute_face);
    if is_defined(standard_8) {
        free bark_speech(standard_8, cute_face);
    }
    wait(0.1);
    free bark_speech(standard_3, cute_face);
    wait(0.1);
    if is_defined(extra_0) {
        free bark_speech(extra_0, cute_face);
    }

    if is_defined(extra_1) {
        free bark_speech(extra_1, cute_face);
    }
    wait(0.1);
    if spouse_party_1 != "dozy" {
        free bark(dozy, cute_face);
    }

    if spouse_party_1 != "henrietta" {
        free bark(henrietta, cute_face);
    }

}

fun reception_setup() {

    //
    set_outfit(spouse, wedding);
    place_actor(spouse, south, "North Table Top 1");
    animate(spouse, sit);
    place_actor(ari, south, "North Table Top 2");
    apply_wedding_outfit();
    animate(ari, sit);
    place_actor(north_table_2, south, "North Table Top 3");
    animate(north_table_2, sit);
    place_actor(north_table_3, west, "North Table Right End");
    animate(north_table_3, sit);
    place_actor(north_table_4, north, "North Table Bottom 3");
    animate(north_table_4, sit);
    place_actor(north_table_5, north, "North Table Bottom 2");
    animate(north_table_5, sit);

    //
    place_actor(north_table_6, north, "North Table Bottom 1");
    animate(north_table_6, sit);
    place_actor(north_table_7, east, "North Table Left End");
    animate(north_table_7, sit);

    //
    place_actor(south_table_0, south, "South Table Top 1");
    animate(south_table_0, sit);
    place_actor(south_table_1, south, "South Table Top 2");
    animate(south_table_1, sit);
    place_actor(south_table_2, south, "South Table Top 3");
    animate(south_table_2, sit);
    place_actor(south_table_3, west, "South Table Right End");
    animate(south_table_3, sit);
    place_actor(south_table_4, north, "South Table Bottom 3");
    animate(south_table_4, sit);
    place_actor(south_table_5, north, "South Table Bottom 2");
    animate(south_table_5, sit);
    place_actor(south_table_6, north, "South Table Bottom 1");
    animate(south_table_6, sit);
    place_actor(south_table_7, east, "South Table Left End");
    animate(south_table_7, sit);

    //
    if is_defined(bar_0) {
        place_actor(bar_0, south, "Top Bar Hang");
    }

    place_actor(bar_1, west, "Top Bar Seat");
    animate(bar_1, sit);
    place_actor(bar_2, west, "Top-Middle Bar Seat");
    animate(bar_2, sit);
    place_actor(bar_3, west, "Bottom-Middle Bar Seat");
    animate(bar_3, sit);
    place_actor(bar_4, west, "Bottom Bar Seat");
    animate(bar_4, sit);

    place_actor(bar_5, west, "Bar Stand North");
    place_actor(bar_6, west, "Bar Stand South");
    if is_defined(bar_7) {
        place_actor(bar_7, west, "Bar Stand Middle");
    }



    place_actor(bartender, east, "Bartender 3");

    //

    //
    place_actor(henrietta, east, henrietta_reception_place);
    place_actor(dozy, west, dozy_reception_place);


    if is_defined(reception_extra_0) {
        place_actor(reception_extra_0, east, "Story Listener 1");
    }

    if is_defined(reception_extra_1) {
        place_actor(reception_extra_1, west, "Story Listener 3");
    }

    //
    //
    //
    //
    //
    //
    //
    //
    //

    //
    //
    //
    //
    //
    //
    //
    //

    //
    //
    //
    //
    //
    //
    //
    //
    //
    //

}

fun reception_chat() {
    sim {
        //
        {
            wait(1.1);
            free bark_speech(spouse, celebration);
            wait(1);
            free bark_speech(north_table_6, cute_face);
            wait(1);
            free bark_speech(north_table_7, heart);
        }
        {
            wait(1);
            free bark_speech(ari, yum);
            wait(1);
            free bark_speech(elsie, celebration);
            wait(1);
            free bark_speech(ari, cute_face);
        }
        {
            wait(0.9);
            free bark_speech(north_table_4, music);
            wait(1);
            free bark_speech(north_table_3, exclamation_mark);
            wait(1);
            free bark_speech(north_table_2, stars);
        }


        //
        {
            wait(0.5);
            free bark_speech(south_table_2, music);
            wait(1);
            free bark_speech(south_table_4, yum);
            wait(1);
            free bark_speech(south_table_3, cute_face);
        }
        {
            wait(0.75);
            free bark_speech(south_table_0, cold_drink);
            wait(1);
            free bark_speech(south_table_7, music);
            wait(1);
            free bark_speech(south_table_6, celebration);
        }
        {
            wait(1.25);
            free bark_speech(south_table_2, cute_face);
            wait(1);
            free bark_speech(north_table_5, heart);
            wait(1);
            free bark_speech(north_table_2, music);
        }

        //
        {
            free bark_speech(bar_2, cold_drink);
            wait(1);
            free bark_speech(bar_3, cute_face);
            wait(1);
            free bark_speech(bar_1, celebration);
            wait(1);
            free bark_speech(bar_4, heart);
        }

        //
        if is_defined(reception_extra_0) {
            wait(1.3);
            free bark_speech(reception_extra_0, music);
        }

        if is_defined(reception_extra_1) {
            wait(2.3);
            free bark_speech(reception_extra_1, hot_drink);
        }

        {
            wait(0.8);
            free bark(dozy, question_mark);
            wait(1);
            free bark(henrietta, hay);
            wait(1);
            free bark(dozy, yum);
        }
    }

}


fun reception_cheer() {
    free bark_speech(north_table_2, cute_face);
    free bark_speech(north_table_3, cute_face);
    free bark_speech(north_table_4, cute_face);
    free bark_speech(north_table_5, cute_face);
    //
    if spouse == "balor" or spouse == "caldarus" or spouse == "hayden" or spouse == "march" or spouse == "seridia" or spouse == "valen" {
        free bark_speech(north_table_6, cute_face);
    }

    if spouse != "juniper" {
        free bark_speech(south_table_0, cute_face);
    }
    free bark_speech(south_table_1, cute_face);
    free bark_speech(south_table_2, cute_face);
    free bark_speech(south_table_3, cute_face);
    free bark_speech(south_table_4, cute_face);
    free bark_speech(south_table_5, cute_face);
    if spouse != "juniper" {
        free bark_speech(south_table_6, cute_face);
        free bark_speech(south_table_7, cute_face);
    }
    if is_defined(bar_0) {
        free bark_speech(bar_0, cute_face);
    }
    free bark_speech(bar_1, cute_face);
    free bark_speech(bar_2, cute_face);
    free bark_speech(bar_3, cute_face);
    free bark_speech(bar_4, cute_face);
    free bark_speech(bar_5, cute_face);
    free bark_speech(bar_6, cute_face);
    if is_defined(bar_7) {
        free bark_speech(bar_7, cute_face);
    }
    free bark_speech(bartender, cute_face);

    if is_defined(reception_extra_0) {
        free bark_speech(reception_extra_0, cute_face);
    }

    if is_defined(reception_extra_1) {
        free bark_speech(reception_extra_1, cute_face);
    }

    free bark(dozy, cute_face);
    free bark(henrietta, cute_face);

}

fun reception_staggered_cheer() {
    wait(0.1);
    free bark_speech(north_table_3, music);
    free bark_speech(south_table_4, music);
    free bark_speech(bartender, heart);
    wait(0.1);
    free bark(dozy, cute_face);
    free bark_speech(north_table_5, celebration);
    free bark_speech(south_table_3, cute_face);
    //
    if spouse == "balor" or spouse == "caldarus" or spouse == "hayden" or spouse == "march" or spouse == "seridia" or spouse == "valen" {
        free bark_speech(north_table_6, cute_face);
    }
    wait(0.1);
    free bark_speech(bar_6, celebration);
    if spouse != "juniper" {
        free bark_speech(south_table_0, cute_face);
    }
    free bark_speech(south_table_1, cute_face);
    free bark_speech(bar_5, cute_face);
    free bark_speech(south_table_2, heart);
    wait(0.1);

    free bark_speech(north_table_4, cute_face);
    free bark_speech(bar_2, heart);
    free bark_speech(bar_3, cute_face);
    wait(0.1);
    free bark_speech(south_table_5, cute_face);
    if spouse != "juniper" {
        free bark_speech(south_table_6, celebration);
        free bark_speech(south_table_7, cute_face);
    }
    if is_defined(bar_0) {
        free bark_speech(bar_0, music);
    }
    free bark_speech(north_table_2, cute_face);
    wait(0.1);
    free bark(henrietta, cute_face);
    free bark_speech(bar_1, cute_face);
    wait(0.1);
    free bark_speech(bar_4, celebration);

    wait(0.1);
    if is_defined(bar_7) {
        free bark_speech(bar_7, cute_face);
    }
    wait(0.1);
    if is_defined(reception_extra_0) {
        free bark_speech(reception_extra_0, cute_face);
    }

    if is_defined(reception_extra_1) {
        free bark_speech(reception_extra_1, music);
    }

}


