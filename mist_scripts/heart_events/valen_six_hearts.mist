		face(juniper, north);
	}
}
wait(0.5);
next_line(); //
close_textbox();
wait(1);
free bark_speech(juniper, ellipses);
wait(2);
sim {
	{
		wait(0.25);
		face(valen, west);
		wait(1.5);
		face(valen, north);
	}
	{
		face(ari, east);
		wait(1.5);
		face(ari, north);
