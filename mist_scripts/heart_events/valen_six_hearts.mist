fun on_scene_end() {
	request_music_stop(2);
}

scene(bathhouse);
camera_position(v6h_camera_1);
place_actor(ari, north, v6h_ari_entrance);
place_actor(dozy, east, "Dozy");
animate(dozy, sleep_2);
place_actor(juniper, south, "Front Desk");
place_actor(valen, north, v6h_valen_entrance);
request_music_play(valen);

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		pan_camera(3, v6h_camera_2);
	}
	{
		walk_slow(ari, v6h_ari_start);
		face(ari, north);
	}
	{
		wait(0.5);
		free bark_speech(valen, exclamation_mark);
		wait(0.5);
		face(valen, south);
		wait(1.5);
		face(valen, north);
	}
	{
		wait(3);
		next_line(); //
		next_line(); //
		next_line(); //
	}
	free {
		wait(3.5);
		animate(dozy, doze_2);
		wait(2);
		animate(dozy, doze_1);
	}
}
close_textbox();
wait(0.25);
free bark_speech(valen, annoyed);
wait(1);
animate(juniper, laugh);
play_sound("SoundEffects/NPCs/Vocal/JuniperLaugh");
wait(2.25);
animate(juniper, idle);
sim {
	{
		walk_slow(juniper, v6h_juniper_pause);
		face(juniper, south);
		walk_slow(juniper, v6h_ari_start);
		face(juniper, east);
	}
	{
		wait(2);
		face(valen, west);
	}
	{
		wait(2);
		next_line(); //
		close_textbox();
	}
	{
		wait(1.25);
		walk_slow(ari, v6h_ari_back);
		face(ari, north);
	}
	{
		pan_camera(3, v6h_camera_3);
	}
}
wait(0.25);
sim {
	{
		walk_slow(valen, v6h_juniper_notes);
		face(valen, north);
		animate(valen, action);
		wait(0.5);
		setup_prop(v6h_notes);
		animate(valen, idle);
	}
	{
		wait(0.75);
		face(juniper, north);
	}
}

sim {
	{
		walk_slow(valen, v6h_valen_back);
