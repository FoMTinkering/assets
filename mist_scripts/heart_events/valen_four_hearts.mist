scene(clinic_f1);
place_actor(valen, west, v4h_valen_entrance);
place_actor(ari, east, v4h_ari_entrance);
camera_position(v4h_camera_1);
request_music_play(valen);

sim {
	fade_in(2);
	pan_camera(3.5, v4h_camera_2);
	{
		wait(1.5);
		next_line(); //
	}
	{
		wait(1.5);
		animate(valen, action);
		wait(0.5);
		animate(valen, idle);
	}
	{
		wait(2);
		free bark_speech(ari, cute_face);
	}
}

//

if get_response() == 1 {
	sim {
		{
			wait(1);
			face(valen, north);
			wait(1);
			face(valen, west);
		}
		{
			next_line(); //
		}
	}
} else {
	next_line(); //
}
