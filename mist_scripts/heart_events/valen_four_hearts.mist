wait(0.5);
free bark_speech(ari, cute_face);
wait(1);
sim {
	pan_camera(3, v4h_camera_3);
	{
		wait(0.5);
		fade_out(2);
	}
	{
		free walk_slow(valen, v4h_valen_exit);
		wait(0.5);
		walk_slow(ari, v4h_ari_exit);
	}
}
wait(1);

