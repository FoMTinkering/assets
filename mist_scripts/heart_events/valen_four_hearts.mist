animate(ari, action);
wait(0.5);
destroy_prop(valen_potion);
animate(ari, idle);
walk_slow(ari, v4h_ari_experiment);
face(ari, south);
use_item(lurid_colored_drink); //
wait(1);
sim {
	{
		play_sound("SoundEffects/Ari/TakeDamage");
		show_menu(vitals);
		set_ari_health(__get_ari_max_health() / 2);
		set_ari_stamina(__get_ari_max_stamina() / 2);
		await_ari_animation();
		animate(ari, blink);
		wait(0.2);
		freeze_ari();
	}
	{
		wait(0.5);
		free bark_speech(valen, exclamation_mark);
		wait(0.5);
		animate(valen, idle);
	}
}
sim {
	{
		wait(3.25);
		pan_camera(2, v4h_camera_7);
	}
	{
		wait(1);
		free bark_speech(valen, sweat_drop);
		wait(0.25);
		animate(valen, write);
		wait(2);
		animate(valen, idle);
		walk(valen, v4h_valen_barrel);
		face(valen, west);
		animate(valen, action);
		wait(0.5);
		animate(valen, idle);
		wait(0.2);
		walk(valen, v4h_valen_cure);
		face(valen, east);
	}
	{
		next_line(); //
		close_textbox();
	}
	{
		wait(2);
		unfreeze_ari();
		set_ari_health(1);
		set_ari_stamina(1);
		await_ari_animation();
		animate(ari, faint);
		freeze_ari_on_last_frame();
		//
		//
		//
		hide_menu(vitals);
	}
}
sim {
	{
		wait(1);
		pan_camera(2, v4h_camera_4);
	}
	{
		animate(valen, heal);
		wait(1);
		animate(valen, idle);
		create_animation(spr_npc_effect_heal, v4h_heal_animation, 0, 0, 0, -1000);
		//
		set_ari_health(__get_ari_max_health());
		set_ari_stamina(__get_ari_max_stamina());
		//
	}
	{
		wait(1);
		fade_out(2);
	}
}
wait(1);

