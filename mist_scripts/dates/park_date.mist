var partner = get_from_blackboard("date_partner");
set_on_blackboard("block_skip", true);
var alt_scene = partner == "caldarus" and read_world_fact("caldarus_seridia_town") != true;
if alt_scene {
	set_on_blackboard("end_position", "deep_woods/caldarus' front door");
} else {
	set_on_blackboard("end_position", "eastern_road/pd_exit");
}
var outfit = get_from_blackboard("outfit");
var bark_one = "";
var bark_two = "";
var roll = irandom(3);

if roll == 0 {
	bark_one = "fire";
	bark_two = "cooking";
} else if roll == 1 {
	bark_one = "bathhouse";
	bark_two = "cold_drink";
} else if roll == 2 {
	bark_one = "lake";
	bark_two = "fishing";
} else {
	bark_one = "farming";
	bark_two = current_season();
}

//
free bark_speech(partner, heart);
wait(1);
fade_out(2);

if alt_scene {
	scene(deep_woods);
	camera_position(pdc_camera_snap);
	setup_prop(pdc_flower);
	date_prop_edit(pdc_flower);

	//
	capture_date_photo();
	wait_one_tick();
	set_on_blackboard("block_skip", false);

	camera_position(pdc_camera_1);
	place_actor(partner, south, "Caldarus Bench Left");
	place_actor(ari, south, "Caldarus Bench Right");
	set_outfit(partner, outfit);
	animate(partner, "sit");
	animate(ari, sit);

	sim {
		{
			fade_in(2);
		}
		{
			wait(1);
			free bark_speech(partner, bark_one);
			wait(1.5);
			free bark_speech(ari, bark_two);
			wait(2);
			free bark_speech(partner, exclamation_mark);
			wait(1);
		}
	}
	sim {
		{
			place_actor(partner, south, pdc_partner_stand);
			animate(partner, "idle");
			wait(0.25);
			walk_slow(partner, pdc_partner_flower);
			face(partner, west);
			animate(partner, "action");
			wait(0.5);
			destroy_prop(pdc_flower);
			animate(partner, "idle");
			walk_slow(partner, pdc_partner_give);
			face(partner, east);
		}
		{
			wait(0.5);
			free bark_speech(ari, question_mark);
			wait(1);
			place_actor(ari, south, pdc_ari_stand);
			animate(ari, idle);
			wait(1);
			walk_slow(ari, pdc_ari_kiss);
			face(ari, west);
		}
		{
			pan_camera(3, pdc_camera_2);
		}
	}
	wait(0.5);
	animate(partner, "action");
	animate(ari, action);
	wait(0.5);
	animate(partner, "idle");
	animate(ari, idle);
	wait(0.5);
	free bark_speech(ari, cute_face);
	wait(1.5);
	sim {
		walk(partner, pdc_partner_kiss);
		set_move_speed(partner, 0.4);
	}
	face(partner, east);
    kiss_npc(partner);
	wait(1);
	fade_out(2);
} else {
	scene(eastern_road);
	camera_position(pd_camera_snap);
	setup_prop(pd_flower);
	date_prop_edit(pd_flower);

	//
	capture_date_photo();
	wait_one_tick();
	set_on_blackboard("block_skip", false);
	camera_position(pd_camera_1);
	place_actor(partner, south, "Bench Left");
	place_actor(ari, south, "Bench Right");
	set_outfit(partner, outfit);
	animate(partner, "sit");
	animate(ari, sit);

	sim {
		{
			fade_in(2);
		}
		{
			wait(1);
			free bark_speech(partner, bark_one);
			wait(1.5);
			free bark_speech(ari, bark_two);
			wait(2);
			free bark_speech(partner, exclamation_mark);
			wait(1);
		}
	}
	sim {
		{
			place_actor(partner, south, pd_partner_stand);
			animate(partner, "idle");
			wait(0.25);
			walk_slow(partner, pd_partner_flower);
			face(partner, west);
			animate(partner, "action");
			wait(0.5);
			destroy_prop(pd_flower);
			animate(partner, "idle");
			walk_slow(partner, pd_partner_give);
			face(partner, east);
		}
		{
			wait(1);
			free bark_speech(ari, question_mark);
			wait(1);
			place_actor(ari, south, pd_ari_stand);
			animate(ari, idle);
			wait(0.25);
			walk_slow(ari, pd_ari_kiss);
			face(ari, west);
		}
		{
			pan_camera(4, pd_camera_2);
		}
	}
	animate(partner, "action");
	animate(ari, action);
	wait(0.5);
	animate(partner, "idle");
	animate(ari, idle);
	wait(0.5);
	free bark_speech(ari, cute_face);
	wait(1.5);
	sim {
		walk(partner, pd_partner_kiss);
		set_move_speed(partner, 0.4);
	}
	face(partner, east);
	kiss_npc(partner);
	wait(1);
	fade_out(2);
}
