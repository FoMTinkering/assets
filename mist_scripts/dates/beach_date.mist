var partner = get_from_blackboard("date_partner");
set_on_blackboard("block_skip", true);
var alt_scene = partner == "caldarus" and read_world_fact("caldarus_seridia_town") != true;
if alt_scene {
	set_on_blackboard("end_position", "eastern_road/deep_woods_cutscene_exit");
} else {
	set_on_blackboard("end_position", "beach/cutscene_exit");
}
var outfit = get_from_blackboard("outfit");
var bark_one = "";
var bark_two = "";
var bark_three = "";

var roll = irandom(3);

if roll == 0 {
	bark_one = "summer";
	bark_two = "cooking";
	bark_three = "fire";
} else if roll == 1 {
	bark_one = "heatwave";
	bark_two = "cold_drink";
	bark_three = "yum";
} else if roll == 2 {
	bark_one = "beach";
	bark_two = "fishing";
	bark_three = "terithia";
} else {
	bark_one = "lake";
	bark_two = "beach";
	bark_three = "cute_face";
}

//
free bark_speech(partner, heart);
wait(1);
fade_out(2);

if alt_scene {
	scene(deep_woods);
	camera_position(bdc_camera_4);
	setup_prop(bdc_seashell);
	date_prop_edit(bdc_seashell);

	//
	capture_date_photo();
	wait_one_tick();
	set_on_blackboard("block_skip", false);

	//
	camera_position(bdc_camera_1);
	place_actor(partner, north, bdc_partner_entrance);
	place_actor(ari, north, bdc_ari_entrance);
	set_outfit(partner, outfit);

	sim {
		{
			wait(0.25);
			fade_in(2);
		}
		{
			wait(1);
			free bark_speech(ari, bark_one);
			wait(1.5);
			free bark_speech(partner, bark_two);
			wait(1.5);
		}
		{
			pan_camera(4, bdc_camera_2);
		}
		{
			sim {
				walk(ari, bdc_ari_start);
				set_move_speed(ari, 0.4);
			}
			face(ari, north);
		}
		{
			sim {
				walk(partner, bdc_partner_start);
				set_move_speed(partner, 0.4);
			}
			face(partner, north);
			free bark_speech(partner, exclamation_mark);
			wait(0.5);
			face(partner, west);
			wait(0.5);
		}
	}
	sim {
		{
			walk_slow(partner, bdc_partner_seashell);
			face(partner, west);
			animate(partner, "action");
			wait(0.5);
			destroy_prop(bdc_seashell);
			animate(partner, "idle");
		}
		{
			pan_camera(2, bdc_camera_3);
		}
		{
			face(ari, west);
			wait(1);
			free bark_speech(ari, question_mark);
			wait(1);
		}
	}
	sim {
		{
			walk_slow(partner, bdc_partner_give);
			face(partner, east);
		}
		{
			pan_camera(2, bdc_camera_4);
		}
	}
	animate(partner, "action");
	animate(ari, action);
	wait(0.5);
	animate(partner, "idle");
	animate(ari, idle);
	wait(0.5);
	free bark_speech(ari, cute_face);
	wait(1.5);
	sim {
		walk(partner, bdc_partner_kiss);
		set_move_speed(partner, 0.4);
	}
	face(partner, east);
	kiss_npc(partner);
	fade_out(2);
} else {
	scene(beach);
	camera_position(bd_camera_snap);
	setup_prop(bd_seashell);
	date_prop_edit(bd_seashell);

	//
	capture_date_photo();
	wait_one_tick();
	set_on_blackboard("block_skip", false);

	//
	camera_position(bd_camera_1);
	place_actor(partner, east, bd_partner_entrance);
	place_actor(ari, east, bd_ari_entrance);
	set_outfit(partner, outfit);

	sim {
		{
			wait(0.25);
			fade_in(2);
		}
		{
			wait(1);
			free bark_speech(ari, bark_one);
			wait(1.5);
			free bark_speech(partner, bark_two);
			wait(2);
			free bark_speech(partner, exclamation_mark);
			wait(1);
		}
		{
			pan_camera(4, bd_camera_2);
		}
		{
			sim {
				walk(ari, bd_ari_start);
				set_move_speed(ari, 0.4);
			}
			face(ari, east);
		}
		{
			sim {
				walk(partner, bd_partner_start);
				set_move_speed(partner, 0.4);
			}
			face(partner, east);
		}
	}
	sim {
		{
			walk_slow(partner, bd_partner_seashell);
			face(partner, east);
			animate(partner, "action");
			wait(0.5);
			destroy_prop(bd_seashell);
			animate(partner, "idle");
		}
		{
			pan_camera(2, bd_camera_3);
		}
		{
			wait(1);
			free bark_speech(ari, question_mark);
			wait(1);
		}
	}
	sim {
		{
			walk_slow(partner, bd_partner_give);
			face(partner, west);
		}
		{
			pan_camera(2, bd_camera_4);
		}
	}
	animate(partner, "action");
	animate(ari, action);
	wait(0.5);
	animate(partner, "idle");
	animate(ari, idle);
	wait(0.5);
	free bark_speech(ari, cute_face);
	wait(1.5);
	sim {
		walk(partner, bd_partner_kiss);
		set_move_speed(partner, 0.4);
	}
	face(partner, west);
	kiss_npc(partner);
	wait(1);
	fade_out(2);
}
