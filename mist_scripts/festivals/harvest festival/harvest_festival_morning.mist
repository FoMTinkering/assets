scene(farm);

var speaker = "undefined";

if read_world_fact("reina_is_spouse") == true {
	speaker = "josephine";
	set_conversation("Cutscenes/Festival Events/harvest_festival/harvest_festival_morning_alt");

} else {
	speaker = "reina";
	set_conversation("Cutscenes/Festival Events/harvest_festival/harvest_festival_morning");
}

request_music_play("Music/Events/Cutscene");
camera_position(hfm_camera_1);
place_actor(ari, south, hfm_ari_door);
place_actor(speaker, west, hfm_reina_entrance);


sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		walk_slow(speaker, hfm_reina_start);
		face(speaker, west);
	}
	{
		wait(1);
		free bark_speech(ari, exclamation_mark);
		wait(0.5);
		face(ari, east);
	}
	{
		wait(1.75);
		free bark_speech(speaker, cute_face);
		wait(1);
	}
	{
		walk(ari, hfm_ari_entrance);
		face(ari, south);
	}
	{
		wait(2);
		next_line(); //
		next_line(); //
	}
	pan_camera(1.5, hfm_camera_2);
}
close_textbox();
wait(0.5);
free bark_speech(ari, music);
wait(1);
animate(ari, action);
wait(0.1);
animate(speaker, action);
wait(0.4);
animate(ari, idle);
wait(0.1);
animate(speaker, idle);
wait(0.5);
free bark_speech(speaker, cute_face);
wait(0.5);
next_line(); //
next_line(); //
close_textbox();
wait(0.5);
free bark_speech(speaker, cute_face);
wait(0.5);
free bark_speech(ari, cute_face);
wait(0.5);
sim {
	fade_out(2);
	{
		wait(0.5);
		walk_slow(speaker, hfm_reina_exit);
		face(speaker, east);
	}
}
