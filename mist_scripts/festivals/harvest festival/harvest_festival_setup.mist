		}
	}
	if read_world_fact("shooting_star_reina_attended") == true {
		close_textbox();
		wait(0.5);
		free bark_speech(speaker, blush);
		wait(1.5);
	}
	next_line(); //

	//
	if get_response() == 0 {
		sim {
			{
				wait(0.75);
				free bark_speech(speaker, cute_face);
			}
			{
				next_line(); //
			}
		}
	} else {
		sim {
			{
				wait(0.75);
				free bark_speech(speaker, exclamation_mark);
			}
			{
				next_line(); //
			}
		}
	}
	next_line(); //
	close_textbox();
	wait(0.5);
	free bark_speech(ari, question_mark);
	wait(1);
	next_line(); //
	next_line(); //
	next_line(); //
	next_line(); //
	//
