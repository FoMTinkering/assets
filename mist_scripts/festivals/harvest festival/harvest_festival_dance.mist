	face(partner_a, east);
	wait(0.5);
	face(partner_a, west);
	wait(0.5);

	//
	walk_slow(partner_a, a_x, a_y);
	face(partner_a, west);
	wait(0.5);
	face(partner_a, east);
	wait(0.5);

	//

	//
	walk_slow(partner_a, a_x, a_y+18);
	face(partner_a, south);
	walk_slow(partner_a, a_x+18, a_y+18);
	face(partner_a, east);
	walk_slow(partner_a, a_x+18, a_y);
	face(partner_a, west);

	//
	walk_slow(partner_a, a_x+9, a_y);
	face(partner_a, west);
	animate(partner_a, "walk");
	wait(0.25);
	walk_slow(partner_a, a_x+18, a_y);
	face(partner_a, west);
	wait(0.25);

	//
	walk_slow(partner_a, a_x+18, a_y-18);
	face(partner_a, north);
	walk_slow(partner_a, a_x, a_y-18);
	face(partner_a, west);
	walk_slow(partner_a, a_x, a_y);
	face(partner_a, east);

	//
	walk_slow(partner_a, a_x-9, a_y);
	face(partner_a, east);
	wait(0.5);
	walk_slow(partner_a, a_x, a_y);
	face(partner_a, east);
	wait(0.25);

	//
	wait(1.5);

	//
	animate(partner_a, "walk");
	face(partner_a, south);
	wait(0.5);
	face(partner_a, west);
	wait(0.5);
	face(partner_a, north);
	wait(0.5);
	face(partner_a, east);

	//
	walk_slow(partner_a, a_x+18, a_y);
	face(partner_a, east);
	wait(0.5);
	face(partner_a, west);
	wait(0.5);

	//
	walk_slow(partner_a, a_x, a_y);
	face(partner_a, west);
	wait(0.5);
	face(partner_a, east);
	wait(0.5);

	//

	//
	walk_slow(partner_a, a_x, a_y-36);
	face(partner_a, north);
	wait(0.25);
	walk_slow(partner_a, a_x, a_y-27);
	face(partner_a, south);

	//
	animate(partner_a, "walk");
	wait(0.5);
	face(partner_a, west);
	wait(0.5);
	face(partner_a, north);
	wait(0.5);
	face(partner_a, east);
	animate(partner_a, idle);

	//
	wait(0.5);
	walk_slow(partner_a, a_x, a_y);
	face(partner_a, south);
	wait(0.25);
	face(partner_a, east);


	//
	wait(1.5);

	//
	walk_slow(partner_a, a_x, a_y+36);
	face(partner_a, south);
	wait(0.25);
	walk_slow(partner_a, a_x, a_y+27);
	face(partner_a, north);

	//
	animate(partner_a, "walk");
	wait(0.5);
	face(partner_a, west);
	wait(0.5);
	face(partner_a, south);
	wait(0.5);
	face(partner_a, east);
	animate(partner_a, idle);

	//
	wait(0.5);
	walk_slow(partner_a, a_x, a_y);
	face(partner_a, north);
	wait(0.25);
	face(partner_a, east);

	//
	if partner_a == "ari" {
		free bark_speech(partner_a, cute_face);
		//
	} else {
		//
	}


}


