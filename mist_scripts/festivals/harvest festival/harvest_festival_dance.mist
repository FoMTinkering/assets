
//
var romance_partner = read_world_fact("harvest_festival_dance_partner");
set_on_blackboard("block_skip", true);

fun west_dance(partner_a, partner_a_spawn) {
	var a_x = __get_element_x(partner_a_spawn);
	var a_y = __get_element_y(partner_a_spawn);


	//

	//
	walk_slow(partner_a, a_x, a_y-36);
	face(partner_a, north);
	wait(0.5);

	//
	animate(partner_a, "walk");
	face(partner_a, west);
	wait(0.5);
	face(partner_a, south);
	wait(0.5);
	face(partner_a, east);
	wait(0.5);

	//
	walk_slow(partner_a, a_x, a_y);
	face(partner_a, south);
	wait(0.5);

	//
	animate(partner_a, "walk");
	face(partner_a, west);
	wait(0.5);
	face(partner_a, north);
	wait(0.5);
	face(partner_a, east);
	wait(0.5);

	//
	walk_slow(partner_a, a_x, a_y-9);
	face(partner_a, north);
	walk_slow(partner_a, a_x, a_y+9);
	face(partner_a, south);
	wait(0.5);
	face(partner_a, north);

	//
	wait(0.5);
	walk_slow(partner_a, a_x, a_y);
	wait(0.25);
	face(partner_a, east);
	wait(0.5);

	//
	walk_slow(partner_a, a_x-36, a_y);
	face(partner_a, west);
	wait(0.5);
	face(partner_a, east);

	//
	wait(0.5);
	walk_slow(partner_a, a_x, a_y);
	face(partner_a, east);


	//

	//
	walk_slow(partner_a, a_x, a_y+36);
	face(partner_a, south);
	wait(0.5);

	//
	animate(partner_a, "walk");
	face(partner_a, west);
	wait(0.5);
	face(partner_a, north);
	wait(0.5);
	face(partner_a, east);
	wait(0.5);

	//
	walk_slow(partner_a, a_x, a_y);
	face(partner_a, north);
	wait(0.5);

	//
	animate(partner_a, "walk");
	face(partner_a, west);
	wait(0.5);
	face(partner_a, south);
	wait(0.5);
	face(partner_a, east);
	wait(0.5);

	//
	walk_slow(partner_a, a_x, a_y+9);
	face(partner_a, south);
	walk_slow(partner_a, a_x, a_y-9);
	face(partner_a, north);
	wait(0.5);
	face(partner_a, south);

	//
	wait(0.5);
	walk_slow(partner_a, a_x, a_y);
	wait(0.25);
	face(partner_a, east);
	wait(0.5);

	//
	face(partner_a, east);
	wait(0.25);
	walk_slow(partner_a, a_x-9, a_y);
	face(partner_a, west);
	wait(0.5);
	face(partner_a, east);
	wait(0.5);

	//
	walk_slow(partner_a, a_x, a_y);
	face(partner_a, east);
	wait(1.25);

	//

	//
	walk_slow(partner_a, a_x, a_y-18);
	face(partner_a, north);
	walk_slow(partner_a, a_x+18, a_y-18);
	face(partner_a, east);
	walk_slow(partner_a, a_x+18, a_y);
	face(partner_a, west);

	//
	walk_slow(partner_a, a_x+27, a_y);
	face(partner_a, west);
	wait(0.5);
	walk_slow(partner_a, a_x+18, a_y); //
	face(partner_a, west);
	wait(0.25);

	//
	walk_slow(partner_a, a_x+18, a_y+18);
	face(partner_a, south);
	walk_slow(partner_a, a_x, a_y+18);
	face(partner_a, west);
	walk_slow(partner_a, a_x, a_y);
	face(partner_a, east);

	//
	walk_slow(partner_a, a_x+9, a_y);
	face(partner_a, east);
	animate(partner_a, "walk");
	wait(0.25);
	walk_slow(partner_a, a_x, a_y);
	face(partner_a, east);
	wait(0.25);

	//
	animate(partner_a, "walk");
	face(partner_a, north);
	wait(0.5);
	face(partner_a, west);
	wait(0.5);
	face(partner_a, south);
	wait(0.5);
	face(partner_a, east);
