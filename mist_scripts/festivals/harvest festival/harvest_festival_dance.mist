if romance_partner == "caldarus" and read_world_fact("caldarus_seridia_town") == false {
	scene(deep_woods);
	place_actor(ari, east, hfd_dww_0);
	place_actor(caldarus, west, hfd_dwe_0);
	__harvest_festival_pathfind_setup();
	camera_position(hfd_camera_deep_woods);
	capture_date_photo();
	wait_one_tick();
	set_on_blackboard("block_skip", false);
	fade_in(2);
	sim {
		west_dance(ari, hfd_dww_0);
		east_dance(caldarus, hfd_dwe_0);
		request_music_play("Music/Events/HarvestFestivalDance");
	}
	sim {
		{
			wait(0.5);
			fade_out(2);
		}
		{
			request_music_stop(1.5);
		}
	}

} else {
	scene(town);
	place_actor(ari, east, hfd_cw_0);
	place_actor(romance_partner, west, hfd_ce_0);
	place_actor(hemlock, east, hfd_ww_0);
	place_actor(josephine, west, hfd_we_0);
	place_actor(holt, west, hfd_ee_0);
	place_actor(nora, east, hfd_ew_0);
	enable_simple_pathfinding();
	camera_position(hfd_camera_town);
	capture_date_photo();
	wait_one_tick();
	set_on_blackboard("block_skip", false);
	fade_in(2);
	sim {
		west_dance(ari, hfd_cw_0);
		east_dance(romance_partner, hfd_ce_0);
		west_dance(hemlock, hfd_ww_0);
		east_dance(josephine, hfd_we_0);
		west_dance(nora, hfd_ew_0);
		east_dance(holt, hfd_ee_0);
		request_music_play("Music/Events/HarvestFestivalDance");
	}
	sim {
		{
			wait(0.5);
			fade_out(2);
		}
		{
			request_music_stop(1.5);
		}
	}
}
__harvest_festival_pathfind_finish();
