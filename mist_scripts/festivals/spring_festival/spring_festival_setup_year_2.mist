scene(farm);
request_music_play("Music/Events/Cutscene");
camera_position(sfs_camera_1);
var speaker = "undefined";

if read_world_fact("celine_is_spouse") == true {
	speaker = "holt";
	set_conversation("Cutscenes/Festival Events/spring_festival/spring_festival_setup_alt");
	place_actor(speaker, west, sfs_celine_entrance);
} else {
	speaker = "celine";
	set_conversation("Cutscenes/Festival Events/spring_festival/spring_festival_setup_year_2");
	place_actor(speaker, north, sfs_celine_entrance);
	animate(speaker, action);
	set_outfit(speaker, spring);
}

place_actor(ari, south, sfm_ari_door);

sim {
	fade_in(2);
	{
		walk(ari, sfs_ari_entrance);
		face(ari, south);
	}
	{
		wait(0.5);
		free bark_speech(ari, exclamation_mark);
		wait(0.25);
		face(ari, east);
	}
	{
		wait(1);
		if speaker == "celine" {
			free bark_speech(speaker, exclamation_mark);
			animate(speaker, idle);
			wait(0.25);
			face(speaker, west);
		} else {
			free bark_speech(speaker, cute_face);
		}
	}
	{
		wait(1.25);
		pan_camera(2, sfs_camera_2);
	}
	{
		wait(2.5);
		next_line(); //
	}
}
sim {
	pan_camera(2, sfs_camera_3);
	{
		walk(speaker, sfs_celine_start);
		face(speaker, west);
	}
	{
		next_line(); //
		next_line(); //
		next_line(); //
		next_line(); //
		next_line(); //
	}
}
//
if get_response() == 0 {
	sim {
		{
			wait(0.75);
			free bark_speech(speaker, cute_face);
		}
		{
			next_line(); //
		}
	}
} else {
	sim {
		{
			wait(0.75);
			free bark_speech(speaker, exclamation_mark);
		}
		{
			next_line(); //
			next_line(); //
		}
	}
}
next_line(); //
next_line(); //
next_line(); //
next_line(); //
if get_response() == 0 {
	close_textbox();
	wait(0.25);
	run_tutorial("spring_festival");
	wait(0.25);
} else {
	next_line(); //
}
next_line(); //
next_line(); //
close_textbox();
wait(0.5);
free bark_speech(speaker, cute_face);
wait(1);
free bark_speech(ari, cute_face);
wait(0.5);
fade_out(2);
