//
//
//
//

scene(farm);
request_music_play("Music/Events/Cutscene");
camera_position(sfm_camera_1);
place_actor(ari, south, sfm_ari_door);


var speaker = "undefined";

if read_world_fact("celine_is_spouse") == true {
	speaker = "holt";
	set_conversation("Cutscenes/Festival Events/spring_festival/spring_festival_morning_alt");
	place_actor(speaker, west, sfm_celine_entrance);
} else {
	speaker = "celine";
	set_conversation("Cutscenes/Festival Events/spring_festival/spring_festival_morning");
	place_actor(speaker, west, sfm_celine_entrance);
	set_outfit(speaker, spring);
}

sim {
	fade_in(2);
	{
		walk_slow(speaker, sfm_celine_start);
		face(speaker, west);
	}
	{
		wait(0.5);
		if speaker == "holt" {
			free bark_speech(speaker, cute_face);
		} else {
			free bark_speech(speaker, exclamation_mark);
		}

		wait(0.5);
		free bark_speech(ari, exclamation_mark);
		wait(0.5);
		face(ari, east);
	}
	{
		walk(ari, sfm_ari_entrance);
		face(ari, south);
	}
	{
		wait(2);
		next_line(); //
	}
	pan_camera(1.5, sfm_camera_2);
}
next_line(); //
close_textbox();
wait(0.5);
animate(ari, action);
wait(0.1);
animate(speaker, action);
wait(0.4);
//
animate(ari, idle);
wait(0.1);
animate(speaker, idle);
wait(0.5);
free bark_speech(speaker, cute_face);
wait(0.5);
next_line(); //
close_textbox();
wait(0.5);
free bark_speech(ari, cute_face);
wait(1);
sim {
	fade_out(2);
	{
		wait(0.5);
		walk_slow(speaker, sfm_celine_exit);
		face(speaker, east);
	}
}
