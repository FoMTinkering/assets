scene(summit);
camera_position(shst_camera_1);
request_music_play("Music/Location Tracks/ShootingStarFestival");
stop_ambiance();
play_sound("Ambience/ShootingStarFestival");
place_actor(ari, north, shst_ari_couple_far);
animate(ari, sit);
place_actor(balor, north, shst_date_far);
animate(balor, sit);
setup_prop(shst_blanket);
setup_prop(shst_pouf_ari_far);
setup_prop(shst_pouf_date_far);
__override_post_process_time(22, 30);

start_shooting_stars();

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		pan_camera(4, shst_camera_2);
	}
}
wait(2);
set_on_blackboard("quiet_stars", true);
next_line(); //
next_line(); //
next_line(); //
close_textbox();
free bark_speech(ari, exclamation_mark);
wait(1);
free bark_speech(balor, cute_face);
wait(1);
next_line(); //

//

if get_response() == 0 {
	next_line(); //
	next_line(); //
} else {
	sim {
		{
			wait(0.75);
			free bark_speech(balor, exclamation_mark);
		}
		{
			next_line(); //
			next_line(); //
			next_line(); //
		}
	}
}

close_textbox();

wait(2);
free bark(ari, cute_face);
wait(2);
pan_camera(3, shst_camera_3);
wait(2);
next_line(); //
next_line(); //
close_textbox();
wait(3);
next_line(); //

//
if get_response() == 0 {
	sim {
		{
			wait(0.75);
			free bark_speech(balor, exclamation_mark);
		}
		{
			next_line(); //
			close_textbox();
			wait(1);
			free bark_speech(balor, ellipses);
			wait(3);
			next_line(); //
		}
	}
} else {
	next_line(); //
	next_line(); //
	next_line(); //
}
close_textbox();
wait(3);
free bark(ari, ellipses);
free bark(balor, ellipses);
wait(4);

sim {
	{
		pan_camera(1.5, shst_camera_2);
	}
	{
		next_line(); //
		next_line(); //
	}
	{
		wait(1.25);
		place_actor(balor, north, shst_date_far_stand);
		animate(balor, idle);
		wait(1.5);
		face(balor, east);
	}
	{
		wait(2);
		place_actor(ari, north, shst_ari_couple_far_stand);
		animate(ari, idle);
		wait(0.5);
		face(ari, west);
	}
}
next_line(); //
close_textbox();
wait(0.5);
free bark_speech(ari, cute_face);
wait(0.5);
free bark_speech(balor, cute_face);
wait(1);
sim {
	{
		wait(1);
		pan_camera(5, shst_camera_4);
	}
	{
		wait(4);
		fade_out(3);
	}
}
