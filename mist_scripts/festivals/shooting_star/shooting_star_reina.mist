scene(summit);
camera_position(shst_camera_1);
request_music_play("Music/Location Tracks/ShootingStarFestival");
stop_ambiance();
play_sound("Ambience/ShootingStarFestival");
place_actor(ari, north, shst_ari_couple_near);
animate(ari, sit);
place_actor(reina, north, shst_date_near);
animate(reina, sit);
setup_prop(shst_blanket);
setup_prop(shst_pouf_ari_near);
setup_prop(shst_pouf_date_near);
__override_post_process_time(22, 30);

start_shooting_stars();

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		pan_camera(4, shst_camera_2);
	}
}
wait(1.5);
set_on_blackboard("quiet_stars", true);
next_line(); //
next_line(); //
next_line(); //
close_textbox();
wait(1.5);
free bark(reina, cute_face);
wait(3);
free bark_speech(reina, exclamation_mark);
wait(1);
sim {
	{
		wait(0.5);
		place_actor(reina, north, shst_date_near_stand);
		animate(reina, idle);
		wait(0.25);
		face(reina, east);
		wait(0.5);
		animate(reina, action);
		wait(0.5);
		free bark_speech(ari, cute_face);
		animate(reina, idle);
		wait(0.5);
	}
	{
		next_line(); //
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(ari, cute_face);
wait(1);
free bark_speech(reina, cute_face);
wait(2);
face(reina, north);
wait(0.25);
place_actor(reina, north, shst_date_near);
animate(reina, sit);
wait(1);
pan_camera(3, shst_camera_3);
wait(2);
next_line(); //

//
if get_response() == 0 {
	sim {
		{
			wait(0.75);
			free bark_speech(reina, blush);
		}
		{
			next_line(); //
		}
	}
} else {
	next_line(); //
}

close_textbox();
wait(2);
next_line(); //
next_line(); //
close_textbox();
wait(1);
next_line(); //
next_line(); //

//

if get_response() == 0 {
	sim {
		{
			wait(1);
			free bark_speech(reina, cute_face);
		}
		{
			next_line(); //
		}
	}
} else {
	sim {
		{
			wait(0.75);
			free bark_speech(reina, exclamation_mark);
		}
		{
			next_line(); //
			close_textbox();
			wait(0.5);
			free bark_speech(ari, cute_face);
			wait(2);
			next_line(); //
			next_line(); //
			next_line(); //
		}
	}
}
close_textbox();
wait(1.5);
free bark(ari, heart);
free bark(reina, heart);
wait(3);
pan_camera(3, shst_camera_2);
wait(1);
next_line(); //
next_line(); //
next_line(); //
//

sim {
	{
		wait(2);
		place_actor(reina, north, shst_date_near_stand);
		animate(reina, idle);
		wait(0.25);
		face(reina, east);
	}
	{
		wait(1);
		place_actor(ari, north, shst_ari_couple_near_stand);
		animate(ari, idle);
		wait(0.25);
		face(ari, west);
	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(0.5);
free bark_speech(ari, cute_face);
free bark_speech(reina, cute_face);
wait(1);
sim {
	{
		wait(1);
		pan_camera(5, shst_camera_4);
	}
	{
		wait(4);
		fade_out(3);
	}
}
