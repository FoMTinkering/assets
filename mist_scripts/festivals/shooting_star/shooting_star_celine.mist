scene(summit);
camera_position(shst_camera_1);
request_music_play("Music/Location Tracks/ShootingStarFestival");
stop_ambiance();
play_sound("Ambience/ShootingStarFestival");
place_actor(ari, north, shst_ari_couple_near);
animate(ari, sit);
place_actor(celine, north, shst_date_near);
animate(celine, sit);
setup_prop(shst_blanket);
setup_prop(shst_pouf_ari_near);
setup_prop(shst_pouf_date_near);
__override_post_process_time(22, 30);

start_shooting_stars();

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		pan_camera(4, shst_camera_2);
	}
}
wait(2);
set_on_blackboard("quiet_stars", true);
next_line(); //
next_line(); //
close_textbox();
//
//
//
wait(3);
next_line(); //
next_line(); //
next_line(); //
close_textbox();
wait(1.5);
free bark(ari, cute_face);
free bark(celine, cute_face);
wait(3);
next_line(); //
close_textbox();
wait(1);
pan_camera(3, shst_camera_3);
//
//
//
wait(4);
next_line(); //

//

sim {
	{
		wait(0.75);
		free bark_speech(celine, exclamation_mark);
	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(2);
free bark_speech(celine, ellipses);
wait(3);
next_line(); //
next_line(); //
next_line(); //
next_line(); //
close_textbox();
wait(2);
free bark_speech(celine, ellipses);
wait(2);

sim {
	{
		pan_camera(2, shst_camera_2);
	}
	{
		next_line(); //
	}
}

//
if get_response() == 0 {
	sim {
		{
			wait(0.75);
			free bark_speech(celine, exclamation_mark);
		}
		{
			next_line(); //
			next_line(); //
			next_line(); //
		}
	}
} else {
	sim {
		//
		//
		//
		//
		{
			next_line(); //
			next_line(); //
			next_line(); //
		}
	}
}
close_textbox();
wait(1.5);
free bark(celine, cute_face);
wait(3);
sim {
	{

	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(1);
free bark(ari, heart);
free bark(celine, heart);
wait(3);

sim {
	{
		wait(1);
		place_actor(celine, north, shst_date_near_stand);
		animate(celine, idle);
		//
		//
	}
	{
		wait(1.5);
		place_actor(ari, north, shst_ari_couple_near_stand);
		animate(ari, idle);
		//
		//
	}
	{
		next_line(); //
	}
}
sim {
	{
		wait(0.4);
		face(celine, north);
		wait(2.5);
		face(celine, east);
	}
	{
		wait(1);
		face(ari, west);
	}
	{
		next_line(); //
	}
}
next_line(); //
close_textbox();
wait(1);
free bark_speech(ari, cute_face);
wait(1);
free bark_speech(celine, blush);
sim {
	{
		wait(1);
		pan_camera(5, shst_camera_4);
	}
	{
		wait(4);
		fade_out(3);
	}
}
