scene(summit);
camera_position(shst_camera_1);
request_music_play("Music/Location Tracks/ShootingStarFestival");
stop_ambiance();
play_sound("Ambience/ShootingStarFestival");
place_actor(ari, north, shst_ari_couple_near);
animate(ari, sit);
place_actor(hayden, north, shst_date_near);
animate(hayden, sit);
setup_prop(shst_blanket);
setup_prop(shst_pouf_ari_near);
setup_prop(shst_pouf_date_near);
__override_post_process_time(22, 30);

start_shooting_stars();

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		pan_camera(4, shst_camera_2);
	}
}
wait(3);
set_on_blackboard("quiet_stars", true);
next_line(); //
next_line(); //
next_line(); //
close_textbox();
wait(1);
free bark_speech(ari, cute_face);
wait(1);
free bark_speech(hayden, cute_face);
wait(2);
pan_camera(3, shst_camera_3);
wait(3);
next_line(); //
next_line(); //
next_line(); //
next_line(); //
next_line(); //

//
sim {
	{
		wait(1);
		pan_camera(1.5, shst_camera_2);
	}
	{
		next_line(); //
		next_line(); //
	}
}

close_textbox();
wait(1);
pan_camera(3, shst_camera_3);
wait(2);
next_line(); //
next_line(); //
next_line(); //
next_line(); //

close_textbox();
wait(2);
free bark(hayden, sweat_drop);
wait(3);

next_line(); //
next_line(); //
next_line(); //
close_textbox();
wait(1);
free bark(ari, cute_face);
wait(2);
next_line(); //
next_line(); //
next_line(); //
close_textbox();
wait(1.5);
free bark(ari, heart);
free bark(hayden, heart);
wait(4);
sim {
	{
		pan_camera(3, shst_camera_2);
	}
	{
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(3);
next_line(); //
close_textbox();
wait(1);
free bark_speech(ari, cute_face);
wait(1);
free bark_speech(hayden, cute_face);
sim {
	{
		wait(1);
		pan_camera(5, shst_camera_4);
	}
	{
		wait(4);
		fade_out(3);
	}
}
