scene(summit);
camera_position(shst_camera_1);
request_music_play("Music/Location Tracks/ShootingStarFestival");
stop_ambiance();
play_sound("Ambience/ShootingStarFestival");
place_actor(ari, north, shst_ari_couple_near);
animate(ari, sit);
place_actor(ryis, north, shst_date_near);
animate(ryis, sit);
setup_prop(shst_blanket);
setup_prop(shst_pouf_ari_near);
setup_prop(shst_pouf_date_near);
__override_post_process_time(22, 30);

start_shooting_stars();

sim {
	{
		wait(0.25);
		fade_in(2);
	}
	{
		pan_camera(4, shst_camera_2);
	}
}
wait(2);
set_on_blackboard("quiet_stars", true);
next_line(); //
close_textbox();
wait(1);
sim {
	{
		pan_camera(3, shst_camera_3);
	}
	{
		wait(0.5);
		place_actor(ryis, north, shst_date_near_stand);
		animate(ryis, idle);
		wait(0.2);
		sim {
			walk(ryis, shst_date_near_stand_forward);
			set_move_speed(ryis, 0.4);
		}
		face(ryis, north);
	}

}
free bark_speech(ryis, exclamation_mark);
wait(1);
sim {
	{
		wait(0.5);
		face(ryis, east);
		wait(1);
		face(ryis, north);
	}
	{
		next_line(); //
	}
}

next_line(); //
next_line(); //
close_textbox();
wait(2);
free bark_speech(ryis, ellipses);
wait(3);
next_line(); //

//
sim {
	{
		wait(1.25);
		face(ryis, east);
	}
	{
		next_line(); //
	}
}
sim {
	{
		wait(0.75);
		face(ryis, north);
	}
	{
		wait(1.25);
		pan_camera(3, shst_camera_6);
	}
	{
		next_line(); //
		next_line(); //
		next_line(); //
	}
}
close_textbox();
wait(2);
sim {
	{
		wait(0.5);
		face(ryis, east);
	}
	{
		next_line(); //
	}
}
close_textbox();

wait(0.5);
face(ryis, north);
wait(2);
free bark_speech(ryis, ellipses);
wait(3);
free pan_camera(3, shst_camera_2);
sim {
	walk(ryis, shst_date_near_stand);
	set_move_speed(ryis, 0.4);
}
face(ryis, north);
wait(0.25);
place_actor(ryis, north, shst_date_near);
animate(ryis, sit);
wait(2);
next_line(); //
next_line(); //
next_line(); //

//
next_line(); //
close_textbox();
wait(1);
pan_camera(4, shst_camera_3);
wait(2);
next_line(); //
next_line(); //
next_line(); //
next_line(); //

close_textbox();
wait(2);
free bark_speech(ryis, ellipses);
wait(2);

sim {
	{
		pan_camera(2, shst_camera_2);
	}
	{
		next_line(); //
	}
}

//

if get_response() == 0 {
	sim {
		{
			wait(0.75);
			free bark_speech(ryis, blush);
		}
		{
			next_line(); //
			next_line(); //
		}
	}
} else {
	sim {
		{
			wait(0.75);
			free bark_speech(ryis, blush);
		}
		{
			next_line(); //
			next_line(); //
			next_line(); //
		}
	}
}
close_textbox();
wait(3);
next_line(); //
next_line(); //
next_line(); //
close_textbox();
wait(2);
free bark(ari, heart);
free bark(ryis, heart);
wait(3);
next_line(); //

sim {
	{
		wait(1);
		place_actor(ryis, north, shst_date_near_stand);
		animate(ryis, idle);
		wait(0.5);
		face(ryis, east);
	}
	{
		wait(1.75);
		place_actor(ari, north, shst_ari_couple_near_stand);
		animate(ari, idle);
		wait(0.5);
		face(ari, west);
	}
	{
		next_line(); //
	}
}
close_textbox();
wait(1);
free bark_speech(ari, cute_face);
wait(1);
free bark_speech(ryis, cute_face);
sim {
	{
		wait(1);
		pan_camera(5, shst_camera_4);
	}
	{
		wait(4);
		fade_out(3);
	}
}
