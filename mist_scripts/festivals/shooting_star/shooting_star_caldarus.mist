	{
		wait(0.5);
		sim {
			walk(ari, shst_ari_couple_caldarus_stand_forward);
			set_move_speed(ari, 0.4);
		}
		face(ari, west);
	}
	{
		wait(1.5);
		face(caldarus, east);
	}
	{
