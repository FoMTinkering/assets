	{
		face(ari, north);
		wait(0.25);
		place_actor(ari, north, shst_ari_couple_caldarus);
		animate(ari, sit);
	}
	{
		pan_camera(2, shst_camera_2);
	}
	{
		wait(0.75);
		face(caldarus, north);
		wait(0.25);
		place_actor(caldarus, north, shst_date_caldarus);
		animate(caldarus, sit);
	}
}
