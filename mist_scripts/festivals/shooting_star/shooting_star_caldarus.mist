	{
		wait(0.75);
		face(caldarus, north);
	}
	{
		wait(0.5);
		pan_camera(1.5, shst_camera_5);
	}
	{
		next_line(); //
	}
}
//
if get_response() == 0 {
	sim {
		{
			wait(1);
			face(caldarus, east);
		}
		{
			wait(0.5);
			place_actor(ari, north, shst_ari_couple_caldarus_stand);
			animate(ari, idle);
			wait(0.25);
			face(ari, west);
		}
		{
			next_line(); //
		}
	}
	close_textbox();
	wait(0.5);
	free bark_speech(ari, cute_face);
	wait(1);
	next_line(); //
} else {
	sim {
		{
			wait(1);
			face(caldarus, east);
		}
		{
			wait(0.5);
			place_actor(ari, north, shst_ari_couple_caldarus_stand);
			animate(ari, idle);
			wait(0.25);
			face(ari, west);
		}
		{
			next_line(); //
		}
	}
}

close_textbox();
wait(1);
