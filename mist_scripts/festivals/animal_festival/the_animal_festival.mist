var small_rank = get_small_animal_tier();
var large_rank = get_large_animal_tier();

setup_scene();

if small_rank == 3 {
	small_first_place();
} else if small_rank == 2 {
	small_second_place();
} else if small_rank == 1 {
	small_third_place();
} else {
	small_no_place();
}

//

if large_rank == 3 {
	large_first_place();
} else if large_rank == 2 {
	large_second_place();
} else if large_rank == 1 {
	large_third_place();
} else {
	large_no_place();
}

