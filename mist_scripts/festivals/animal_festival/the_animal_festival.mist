fun setup_scene() {
	scene(town);
	place_actor(ari, north, af_ari_entrance);
	place_actor(josephine, north, af_josephine_entrance);
	place_actor(adeline, south, af_adeline_entrance);
	place_actor(ryis, north, af_ryis_entrance);
	place_actor(elsie, north, af_elsie_entrance);
	place_actor(juniper, east, af_juniper_entrance);
	place_actor(dozy, east, af_dozy_entrance);
	place_actor(landen, north, af_landen_entrance);
	place_actor(terithia, north, af_terithia_entrance);
	place_actor(errol, north, af_errol_entrance);
	place_actor(eiland, north, af_eiland_entrance);
	place_actor(luc, north, af_luc_entrance);
	place_actor(reina, north, af_reina_entrance);
	place_actor(maple, north, af_maple_entrance);
	place_actor(valen, north, af_valen_entrance);
	place_actor(hemlock, north, af_hemlock_entrance);
	place_actor(celine, north, af_celine_entrance);
	place_actor(nora, north, af_nora_entrance);
	place_actor(dell, north, af_dell_entrance);
	place_actor(holt, north, af_holt_entrance);
	place_actor(balor, north, af_balor_entrance);
	place_actor(olric, east, af_olric_entrance);
	place_actor(march, north, af_march_entrance);
	place_actor(hayden, west, af_hayden_entrance);
	place_actor(henrietta, west, af_henrietta_entrance);
	place_actor(louis, north, af_louis_entrance);
	place_actor(merri, north, af_merri_entrance);
	if read_world_fact("caldarus_seridia_town") == true {
		place_actor(caldarus, east, af_caldarus_entrance);
		place_actor(seridia, north, af_seridia_entrance);
	}
	animate(adeline, write);
	camera_position(af_camera_1);
}

fun small_first_place() {
	set_conversation("Cutscenes/Festival Events/the_animal_festival/small_first_place");

	sim {
		{
			wait(0.25);
			fade_in(2);
		}
		pan_camera(5, af_camera_2);
		{
			wait(4);
			animate(adeline, idle);
			walk_slow(adeline, af_adeline_start);
			face(adeline, south);
		}
		{
			free bark_speech(juniper, winter);
			free bark_speech(terithia, bathhouse);
			wait(0.25);
			free bark_speech(nora, hot_drink);
			wait(0.5);
			free bark_speech(josephine, cow);
			wait(0.25);
			free bark_speech(luc, chicken);
			wait(0.25);
			free bark_speech(eiland, winter);
		}
	}

	//
	wait(0.25);
	next_line(); //
	next_line(); //
	close_textbox();

	//

	free bark_speech(louis, exclamation_mark);
	sim {
		{
			wait(0.5);
			walk(louis, af_third_place);
			face(louis, south);
		}
		{
			wait(1);
			next_line(); //
			close_textbox();
		}
		{
			wait(0.5);
			free bark_speech(balor, louis);
			wait(0.1);
			free bark_speech(olric, exclamation_mark);
			wait(0.1);
			free bark_speech(josephine, louis);
			wait(0.1);
			free bark_speech(hayden, cute_face);
			wait(0.1);
			free bark_speech(errol, louis);
			wait(0.1);
			free bark_speech(elsie, music);
			wait(0.1);
			free bark_speech(eiland, louis);
			wait(0.1);
		}
	}

	//
	wait(0.5);
	next_line(); //
	next_line(); //

	//
	close_textbox();
	free bark_speech(hayden, cute_face);
	free bark(henrietta, cute_face);
	wait(1);
	sim {
		{
			face(hayden, south);
			wait(0.5);
			face(henrietta, north);
		}
		{
			next_line(); //
		}
	}
	close_textbox();
	sim {
		{
			wait(0.5);
			walk_slow(hayden, af_second_place);
			face(hayden, south);
		}
		{
			wait(1.25);
			face(louis, east);
			wait(1);
			face(louis, south);
		}
		{
			wait(1);
			face(henrietta, west);
		}
		{
			wait(0.5);
			free bark_speech(celine, hayden);
			wait(0.1);
			free bark_speech(ryis, exclamation_mark);
			wait(0.1);
			free bark_speech(holt, cute_face);
			wait(0.1);
			free bark_speech(nora, hayden);
			wait(0.1);
			free bark_speech(landen, cute_face);
			wait(0.1);
			free bark_speech(valen, hayden);
			wait(0.1);
			free bark_speech(dell, hayden);
			wait(0.1);
			free bark_speech(hemlock, exclamation_mark);
			wait(0.1);
			free bark_speech(louis, cute_face);
			wait(0.1);
			free bark_speech(merri, hayden);
			wait(0.1);
			free bark_speech(luc, hayden);
			wait(0.1);
			free bark_speech(maple, hayden);
		}
	}

	//
	wait(0.5);
	next_line(); //
	next_line(); //
	close_textbox();

	free bark_speech(ari, exclamation_mark);
	sim {
		{
			wait(0.25);
			face(ari, west);
			wait(1);
			face(ari, east);
			wait(1);
			face(ari, north);
		}
		{
			wait(2.5);
			walk_slow(ari, af_first_place);
			face(ari, south);
		}
		{
			wait(2.5);
			pan_camera(2, af_camera_3);
		}
		{
			wait(1);
			face(eiland, west);
			wait(0.5);
			face(holt, east);
			face(landen, west);
			wait(0.25);
			face(nora, east);
			face(terithia, west);
			wait(0.25);
			face(merri, west);
			face(eiland, west);
			wait(1.5);
			face(holt, north);
			face(eiland, north);
			wait(0.1);
			face(landen, north);
			face(nora, north);
			wait(0.1);
			face(terithia, north);
			face(merri, north);
		}
		{
			wait(0.5);
			free bark_speech(adeline, heart);
			wait(0.1);
			free bark_speech(olric, cute_face);
			wait(0.1);
			free bark_speech(hemlock, cute_face);
			wait(0.1);
			free bark_speech(ryis, cute_face);
			wait(0.1);
			free bark_speech(louis, cute_face);
			wait(0.1);
			free bark_speech(errol, exclamation_mark);
			free bark_speech(hayden, heart);
			wait(0.1);
			free bark_speech(balor, music);
			free bark_speech(terithia, heart);
			wait(0.1);
			free bark_speech(landen, cute_face);
			free bark_speech(elsie, heart);
			wait(0.1);
			if read_world_fact("caldarus_seridia_town") == true {
				free bark_speech(seridia, cute_face);
				wait(0.1);
			}
			free bark_speech(merri, cute_face);
			free bark_speech(celine, heart);
			wait(0.1);
			free bark_speech(march, exclamation_mark);
			free bark_speech(reina, heart);
			wait(0.1);
			if read_world_fact("caldarus_seridia_town") == true {
				free bark_speech(caldarus, cute_face);
				wait(0.1);
			}
			free bark_speech(maple, heart);
			free bark_speech(luc, exclamation_mark);
			wait(0.1);
			free bark_speech(juniper, exclamation_mark);
			free bark_speech(valen, cute_face);
			wait(0.1);
			free bark_speech(eiland, cute_face);
			wait(0.1);
			free bark_speech(louis, cute_face);
			wait(0.1);
			free bark_speech(holt, heart);
			wait(0.1);
			free bark_speech(nora, cute_face);
		}
	}
	next_line(); //
	next_line(); //
	close_textbox();
	wait(0.5);
	sim {
		{
			face(ari, east);
			wait(0.5);
			face(hayden, west);
			wait(0.5);
			free bark_speech(ari, cute_face);
			wait(0.5);
			free bark_speech(hayden, cute_face);
			wait(0.5);
			face(louis, east);
			wait(0.5);
			face(ari, west);
			wait(0.5);
			free bark_speech(louis, cute_face);
			wait(0.5);
			free bark_speech(ari, cute_face);
		}
		{
			wait(2.5);
			walk_slow(hayden, af_hayden_entrance);
			face(hayden, west);
		}
		{
			wait(4);
			walk_slow(louis, af_louis_entrance);
			face(louis, north);
		}
		{
			wait(5.5);
			walk_slow(ari, af_ari_entrance);
			face(ari, north);
		}
		{
			wait(2);
			pan_camera(5, af_camera_2);
		}
		{
			wait(1);
			animate(adeline, write);
			wait(2);
			animate(adeline, think);
			wait(3);
			animate(adeline, write);
		}
	}
}

