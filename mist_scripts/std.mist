//
//
fun play_bathhouse_scene() {
	scene(bathhouse_bath);
	play_sound("SoundEffects/SpecialEvents/EnterBathhouse");
	place_actor(ari, south, "In Bath");
	camera_position("In Bath");
	show_menu(vitals);
	animate(ari, swim_idle);
	wait(1);
	fade_in(3);
	if __get_ari_health() == __get_ari_max_health() {
		play_sound("SoundEffects/Ari/Heal");
	}
	set_ari_health(__get_ari_max_health());
	set_ari_stamina(__get_ari_max_stamina());
	wait(1);
	fade_out(3);
	hide_menu(vitals);
}

