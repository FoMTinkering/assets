//
fun ari_hold_item(item, count=1, play_toast=true) {
    var card = __get_actor_dir(ari);
    if play_toast {
      play_item_toast(item, count);
    }
    animate(ari, pickup);
    play_sound("SoundEffects/Ari/RaiseAboveHeadAward");
    __ari_hold_item(item);
    wait(0.25);
    face(ari, south);
    wait(1.5);
    face(ari, card);
    animate(ari, idle);
}

//
fun void_ari_hold_item(item, count=1) {
	var card = __get_actor_dir(void_ari);
	animate(void_ari, pickup);
	play_sound("SoundEffects/Ari/RaiseAboveHeadAward");
	__void_ari_hold_item(item);
	wait(0.25);
	face(void_ari, south);
	wait(1.5);
	face(void_ari, card);
	animate(void_ari, idle);
}

