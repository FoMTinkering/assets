fun use_watering_can(x, y, watering_can_item) {
	animate(ari, water);
	free {
		wait(0.2);
		__water_node(x, y);
	}
	ari_set_attachment(watering_can_item);
	await_ari_animation();
	animate(ari, idle);
}

