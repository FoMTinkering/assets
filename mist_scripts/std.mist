//
fun wait(seconds) {
	if _SIMULATE_ {
		seconds = 0;
	}
	var timer = seconds * 60;
} resolve {
	timer = timer - 1;
    return timer <= 0;
}

//
fun wait_one_tick() {
	var timer = 1;
	if _SIMULATE_ {
		timer = 0;
	}
} resolve {
	timer = timer -1;
	return timer <= 0;
}

//
fun timelapse(target_time, length) {
	var start = __get_time();
	var timer = 0;
	var frame_length = length * 60;
	var increment = (target_time - start) / frame_length;
} resolve {
	timer = timer + increment;
	__set_lighting_time(start + timer);
	return start + timer == target_time;
}

