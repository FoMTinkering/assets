} resolve {
	var value = try_take_from_blackboard("naming_done");
	return value == true;
}

fun kiss_npc(npc, with_hearts=true, length=0.5, npc_reset_animation="idle") {
    animate(ari, kiss);
    animate(npc, kiss);
    wait(1.083);
    freeze_ari();
    freeze_actor(npc);

    if length != -1 {
        wait(length);
        unfreeze_ari();
        unfreeze_actor(npc);
        await_npc_animation(npc);
        animate(ari, idle);
        animate(npc, npc_reset_animation);
        if with_hearts {
            free bark_speech(ari, heart);
            free bark_speech(npc, heart);
        }
        wait(0.5);
    }
}
