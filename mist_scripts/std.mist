//
//
fun place_actor(actor, dir, x, y=0) {
    __mark_actor_as_met(actor);
	if __actor_is_present(actor) {
		__move_instant(actor, x, y);
	} else {
		__actor_spawn(actor, x, y);
	}
    animate(actor, idle);
    face(actor, dir);
}

