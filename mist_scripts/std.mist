//
//
fun walk(actor, x, y=0) {
    __set_actor_speed(actor, "fast_walk");

	if _SIMULATE_ {
		__move_instant(actor, x, y);
		return;
	}
    __move(actor, x, y);
} resolve {
	return !__actor_is_moving(actor);
}

//
//
fun walk_slow(actor, x, y=0) {
    __set_actor_speed(actor, "walk");

	if _SIMULATE_ {
		__move_instant(actor, x, y);
		return;
	}

    __move(actor, x, y);
} resolve {
	return !__actor_is_moving(actor);
}

